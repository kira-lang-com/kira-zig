// A named F32 value is 32-bit in LLVM registers/storage while Kira Float (and
// every VM float) is f64. Mixed-width flows must insert fpext/fptrunc: without
// them the native backend emitted invalid IR (fcmp float vs double, ret float
// from a double function — the sokolDpiScale editor/host build failure).

struct Metrics {
    var scale: F32 = 1.0
    var offset: Float = 0.0
}

function f32Source() -> F32 {
    // f64 literal returned from an F32 function: needs fptrunc.
    return 1.5
}

function clampScale() -> Float {
    let s = f32Source()
    // f32 vs f64 literal compare: needs width unification.
    if s < 1.0 {
        return 1.0
    }
    // f32 returned from a Float function: needs fpext.
    return s
}

function takesFloat(value: Float) -> Float {
    return value * 2.0
}

function takesF32(value: F32) -> Float {
    // F32 param used in f64 arithmetic.
    return value + 0.25
}

@Main
function main() {
    print(f32Source())
    print(clampScale())
    // F32 argument into a Float parameter (fpext at the call).
    print(takesFloat(f32Source()))
    // f64 literal into an F32 parameter (fptrunc at the call).
    print(takesF32(0.5))
    // Mixed arithmetic in both operand orders.
    let s = f32Source()
    print(s * 2.0)
    print(2.0 * s)
    print(s + s)
    // F32 local reassigned from an f64 expression.
    var acc: F32 = 0.5
    acc = acc + 0.25
    print(acc)
    // F32 struct field: store from f64, load into f64 arithmetic.
    var m = Metrics {}
    m.scale = 2.5
    m.offset = m.scale + 0.5
    print(m.scale)
    print(m.offset)
    // Comparisons in both directions.
    print(s > 1.0)
    print(1.0 > s)
    return
}
