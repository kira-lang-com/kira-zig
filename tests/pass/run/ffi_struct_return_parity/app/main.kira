// Regression: extern functions returning a struct BY VALUE larger than 16 bytes.
// SysV x86-64 and AAPCS64 return such composites in memory via a hidden pointer
// (x8 on arm64) — the sret path. Previously modeled as a huge integer register
// return on non-Windows, which read garbage and segfaulted (foundation's
// fs_read_file returning the 24-byte fs_read_result was unusable natively).
// Exercises foundation readFile end-to-end: write, read back through the struct
// return, print the round-tripped contents.
import Foundation

@Main
@Native
function main() {
    let ok = writeFile("ffi_struct_return_out.txt", "roundtrip-ok")
    print(ok)
    let c = readFile("ffi_struct_return_out.txt")
    print(c.ok)
    print(c.text)
    return
}
