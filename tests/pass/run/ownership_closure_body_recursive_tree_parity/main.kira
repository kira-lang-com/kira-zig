// The editor rebuild path runs inside closure bodies (`rootBuilder`, `onFrame`).
// Building recursive closure-rich trees there must still drop every local at
// closure-body exit, not just in plain function bodies.

struct Node {
    let id: Int
    let onPress: (Int) -> Int
    let children: [Node]
}

function makeAdder(base: Int): (Int) -> Int {
    return { n in
        return base + n
    }
}

function makeLeaf(id: Int) -> Node {
    return Node {
        id: id
        onPress: makeAdder(id)
        children: []
    }
}

function makeBranch(id: Int) -> Node {
    var children: [Node] = []
    children.append(makeLeaf(id + 10))
    children.append(makeLeaf(id + 20))
    return Node {
        id: id
        onPress: makeAdder(id)
        children: move children
    }
}

function makeTree(seed: Int) -> Node {
    var children: [Node] = []
    children.append(makeBranch(seed + 100))
    children.append(makeBranch(seed + 200))
    return Node {
        id: seed
        onPress: makeAdder(seed)
        children: move children
    }
}

function visit(node: borrow Node) -> Int {
    var total = node.onPress(1)
    var i = 0
    while i < node.children.count {
        total = total + visit(node.children[i])
        i = i + 1
    }
    return total
}

function runBuilder(builder: (Int) -> Int) -> Int {
    var total = 0
    var i = 0
    while i < 200 {
        total = total + builder(i)
        i = i + 1
    }
    return total
}

@Main
function main() {
    let builder: (Int) -> Int = { seed in
        let tree = makeTree(seed)
        return visit(tree)
    }
    print(runBuilder(move builder))
    return
}
