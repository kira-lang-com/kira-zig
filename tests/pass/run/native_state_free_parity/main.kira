struct CounterState {
    var count: Int
    var total: Int
}

@Main
function main() {
    var state = nativeState(CounterState {
        count: 7
        total: 10
    })
    let token = nativeUserData(state)
    var view = nativeRecover<CounterState>(token)
    print(view.count)
    view.count = 12
    print(view.count)
    print(view.total)
    nativeStateFree(token)

    var second = nativeState(CounterState {
        count: 3
        total: 4
    })
    var secondView = nativeRecover<CounterState>(nativeUserData(second))
    print(secondView.count)
    nativeStateFree(second)
    return
}
