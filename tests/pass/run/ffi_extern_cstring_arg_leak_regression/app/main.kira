// Leak regression: a String (array element read-clone) marshalled to an extern
// CString parameter. The marshal copies it into a transient NUL-terminated
// buffer freed after the call — the C side never sees the Kira buffer — so the
// caller must KEEP ownership of the string and free it at scope exit. The old
// extern lowering escaped every arg, orphaning one read-clone per call (the
// ui-foundation uiBatchStateLoadFont / editor 48 B font-path leak).
import Foundation

@FFI.Extern { library: fs; symbol: fs_file_exists; abi: c; }
function rawFileExists(path: CString): CBool;

@Native
function candidates() -> [String] {
    return ["/nonexistent/one.ttf", "/nonexistent/two.ttf", "/nonexistent/three.ttf"]
}

@Native
function probeAll() -> Int {
    var misses = 0
    var round = 0
    while round < 100 {
        let paths = candidates()
        var i = 0
        while i < paths.count {
            if !rawFileExists(paths[i]) {
                misses = misses + 1
            }
            i = i + 1
        }
        round = round + 1
    }
    return misses
}

@Main
@Native
function main() {
    print(probeAll())
    return
}
