// A runtime `main` (inherited execution) passes a reference to a native-bodied
// function as a callback into a native sink. In hybrid mode the callback body is
// stripped from the VM bytecode module (native execution), so the runtime->native
// closure export must recover the (zero) capture metadata from the hybrid manifest
// rather than from the module. Regression guard for the hybrid "runtime closure
// function could not be resolved" SIGABRT.

@Native
function double(x: Int) -> Int {
    return x * 2
}

@Native
function applyCallback(callback: (Int) -> Int, value: Int) -> Int {
    return callback(value)
}

@Main
function main() {
    let f: (Int) -> Int = double
    print(applyCallback(move f, 21))
    return
}
