// Regression for the mid-IR type-classification caches (mid_ir_copyable.zig).
//
// `containsConstructAny` gates ownership: a value carrying a construct-any (an
// existential `some Shape`) is move-only and may not be aliased. An array
// element type is reconstructed as `.named` (resolvedTypeFromStorageText yields
// a bare-name `.named`, never `.enum_instance`) even when the element is an
// enum, so a `.named` classification must consult BOTH the struct and the enum
// tables. If it consults only the struct table, `[Cell]` — an array of an enum
// whose variant carries `some Shape` — is misclassified as construct-any-free,
// and the ownership checker relaxes a required move into an alias.
//
// This case builds an array of such an enum, MOVES it into a struct field
// (ownership transfer of the whole array-of-existentials), then reads through a
// borrow. Run across vm/llvm/hybrid with leak checking so a misclassification
// that mishandled the owned existential payloads surfaces as a leak or crash.

construct Shape {
    @Required let area: Int
}

Shape Circle {
    let r: Int = 1
    let area: Int {
        r
    }
}

Shape Square {
    let s: Int = 1
    let area: Int {
        s
    }
}

enum Cell {
    Filled(some Shape)
    Empty
}

struct Grid {
    var cells: [Cell]
}

function areaOf(c: borrow Cell) -> Int {
    match c {
        Filled(shape) -> return shape.area;
        Empty -> return 0;
    }
}

function totalArea(grid: borrow Grid) -> Int {
    var sum = 0
    var index = 0
    while index < grid.cells.count {
        sum = sum + areaOf(grid.cells[index])
        index = index + 1
    }
    return sum
}

@Main
function main() {
    let cells = [Cell.Filled(Circle(r: 3)), Cell.Empty, Cell.Filled(Square(s: 4))]
    // Move the whole array-of-existential-enum into an owning field.
    let grid = Grid { cells: move cells }
    print(grid.cells.count)
    print(totalArea(grid))
    return
}
