// Leak class #2 regression: every const_closure block is freed at its drop
// point (scope exit / loop overwrite) with typed capture teardown. Before the
// per-closure destructors, each iteration leaked one heap closure block.
// check_leaks = true pins the zero-leak invariant on the LLVM binary.

function makeAdder(base: Int): (Int) -> Int {
    return { n in
        return base + n
    }
}

@Main
function main() {
    var total = 0
    var i = 0
    while i < 3000 {
        let add = makeAdder(i)
        total = total + add(1)
        i = i + 1
    }
    print(total)
    return
}
