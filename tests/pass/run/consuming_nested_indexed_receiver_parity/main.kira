// Codex P1 regression: a consuming method on a NESTED indexed receiver
// (`outer.inner.children[i].render()`) must drain the element. The array
// roots two levels deep, so the root walk must reach `outer` and tombstone
// the element slot — otherwise the callee frees the element while the owning
// array frees the same slot at drop. Leak-gated on llvm.

construct Widget {
    @Required let body: Widget

    @Consuming
    function render() -> [String] {
        return body.render()
    }
}

Widget Leaf(text: String) {
    function render() -> [String] {
        return [text]
    }
}

function build(tag: Int) -> some Widget {
    return Leaf(text: "n")
}

struct Inner {
    var children: [some Widget]
}

struct Outer {
    var inner: Inner
}

function renderNested(outer: Outer) -> Int {
    var total = 0
    var i = 0
    while i < outer.inner.children.count {
        let lines = outer.inner.children[i].render()
        total = total + lines.count
        i = i + 1
    }
    return total
}

@Main
function main() {
    var round = 0
    var total = 0
    while round < 30 {
        var kids: [some Widget] = []
        kids.append(build(round))
        kids.append(build(round + 1))
        let outer = Outer { inner: Inner { children: move kids } }
        total = total + renderNested(move outer)
        round = round + 1
    }
    print(total)
    return
}
