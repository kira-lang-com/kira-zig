// Codex regression: Kira takes the shift amount mod 64. The LLVM backend passed
// the raw RHS to shl/lshr/ashr, where a count >= 64 is poison/UB and diverges
// from the VM. Using a runtime `amt` (not a constant) forces the backend shift
// path; all three backends must agree on the masked result.

@Main
function main() {
    var a = 3
    var amt = 64
    print(a << amt)      // 64 mod 64 = 0  -> 3
    amt = 65
    print(a << amt)      // 65 mod 64 = 1  -> 6
    var b = 4096
    amt = 66
    print(b >> amt)      // 66 mod 64 = 2  -> 1024
    amt = 128
    print(a << amt)      // 128 mod 64 = 0 -> 3
    return
}
