// EdOpenMenuTap-shaped regression: a body-wrapper forwards its @Content
// children into a nested widget via `For(child in children) { child }` — an
// array-to-array move of move-only Any elements. Each child must MOVE (drain)
// out of the source array, not alias, or the source array's teardown and the
// destination's consuming dispatch both free the same shell. Leak-gated.

construct Widget {
    @Required let body: Widget

    @Consuming
    function render() -> [String] {
        return body.render()
    }
}

Widget Leaf(text: String) {
    function render() -> [String] {
        return [text]
    }
}

function renderedChildren(widgets: [any Widget]) -> [String] {
    var out: [String] = []
    var index = 0
    while index < widgets.count {
        let lines = widgets[index].render()
        var j = 0
        while j < lines.count {
            out.append(lines[j])
            j = j + 1
        }
        index = index + 1
    }
    return out
}

Widget Holder() {
    @Content let children: [Widget]

    function render() -> [String] {
        return renderedChildren(children)
    }
}

// Forwards its children into a Holder via For re-emit (the EdOpenMenuTap shape).
Widget Forward() {
    @Content let children: [Widget]

    body {
        Holder() {
            For(child in children) {
                child
            }
        }
    }
}

@Main
function main() {
    var round = 0
    while round < 30 {
        let rendered = Forward() {
            Leaf(text = "a")
            Leaf(text = "bb")
        }.render()
        var checksum = 0
        var index = 0
        while index < rendered.count {
            checksum = checksum + rendered[index].count
            index = index + 1
        }
        if checksum != 3 {
            print("bad checksum")
            return
        }
        round = round + 1
    }
    print("ok")
    return
}
