// `let alias = bag.items` partially moves the array field out of `bag` — a
// Rust-parity partial move. The moved read TRANSFERS ownership with storage
// nulling (VM load_indirect moved-void, LLVM load.move.field null), so `bag`
// drops at function exit with only its remaining fields while `alias` owns
// the array. No re-init required; leak-gated on llvm to prove neither a leak
// nor a double free. (This test previously asserted the pre-partial-move
// rejection of the same pattern.)
struct Bag {
    var items: [Int]
}

function leak(bag: Bag) -> Int {
    let alias = bag.items
    return alias.count
}

@Main
function main() {
    let bag = Bag { items: [1, 2, 3] }
    print(leak(move bag))
    return
}
