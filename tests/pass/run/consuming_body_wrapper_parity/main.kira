// Body-consumes-self (consuming receivers): the family method that expands
// `body` is declared `@Consuming`, so every implementation takes `self`
// OWNED. A wrapper widget's body block may then capture its `@Content` field
// into a fresh construct (`Frame(pad: 1) { content }`) — a partial move out
// of owned self (the field slot is nulled/voided; the remaining shell drops
// at body exit). The whole chain is move-only: the receiver transfers at
// every dispatch, the callee owns and frees, and no Any value is ever
// cloned. Leak-gated on llvm: no node may leak and none may double-free.

construct Widget {
    @Required let body: Widget

    @Consuming
    function render() -> [String] {
        return body.render()
    }
}

Widget Leaf(text: String) {
    function render() -> [String] {
        return [text]
    }
}

Widget Frame(pad: Int) {
    @Content let content: Widget

    function render() -> [String] {
        var out: [String] = ["frame"]
        let inner = content.render()
        var index = 0
        while index < inner.count {
            out.append(inner[index])
            index = index + 1
        }
        return out
    }
}

// EdFlex-shaped wrapper: no render of its own; its body wraps the content
// channel into another widget. Rendering it dispatches the monomorphized
// consuming default, which consumes self through the body accessor.
Widget Wrap() {
    @Content let content: Widget

    body {
        Frame(pad: 1) {
            content
        }
    }
}

@Main
function main() {
    var round = 0
    while round < 30 {
        let rendered = Wrap() {
            Leaf(text = "hi")
        }.render()
        var index = 0
        var checksum = 0
        while index < rendered.count {
            checksum = checksum + rendered[index].count
            index = index + 1
        }
        if checksum != 7 {
            print("bad checksum")
            return
        }
        round = round + 1
    }
    print("ok")
    return
}
