// Closures with several by-value captures: the block's capture array is
// larger than one slot, and every capture (all .copy) must be readable after
// the source locals are gone. Churn makes any block mis-free deterministic.

function makeMixer(a: Int, b: Int, c: Bool): (Int) -> Int {
    let bias = a * 10
    return { n in
        if c {
            return bias + b + n
        }
        return bias - b + n
    }
}

@Main
function main() {
    var total = 0
    var i = 0
    while i < 2000 {
        let even = i - (i / 2) * 2 == 0
        let mix = makeMixer(i, 7, even)
        total = total + mix(1)
        i = i + 1
    }
    print(total)
    return
}
