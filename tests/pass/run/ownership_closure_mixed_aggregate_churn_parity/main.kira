// Integration churn across the deep-value ownership models: strings (class
// #1) and closures (class #2) inside the same structs and arrays, rebuilt
// repeatedly. Guards cross-model interference — e.g. a closure-field release
// must not disturb the sibling string field's buffer and vice versa.

struct Card {
    var title: String
    var score: (Int) -> Int
}

function makeAdder(base: Int): (Int) -> Int {
    return { n in
        return base + n
    }
}

function buildDeck(count: Int) -> [Card] {
    var deck: [Card] = []
    var i = 0
    while i < count {
        deck.append(Card { title: "card-" + "n", score: makeAdder(i) })
        i = i + 1
    }
    return move deck
}

@Main
function main() {
    var total = 0
    var round = 0
    while round < 150 {
        var deck = buildDeck(10)
        // Overwrite one slot per round: replaced card (string + closure) drops.
        deck[3] = Card { title: "hot" + "-swap", score: makeAdder(100) }
        var i = 0
        while i < 10 {
            let card = deck[i]
            let f = card.score
            total = total + f(1)
            i = i + 1
        }
        let sample = deck[3]
        if sample.title == "hot-swap" {
            total = total + 1
        }
        round = round + 1
    }
    print(total)
    return
}
