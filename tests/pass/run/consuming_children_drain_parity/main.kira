// Owned-array element DRAIN through consuming dispatch: a widget with
// `@Content let children: [Widget]` renders by draining each element into
// the consuming family method (`children[index].render()`), after the array
// itself was partial-moved out of owned self into an owned helper parameter.
// Every drained slot tombstones to VOID (array release skips it); the array
// shell and the remaining voids drop with the callee's owned parameter.
// Leak-gated on llvm: no node, element, or array may leak or double-free.

construct Widget {
    @Required let body: Widget

    @Consuming
    function render() -> [String] {
        return body.render()
    }
}

Widget Leaf(text: String) {
    function render() -> [String] {
        return [text]
    }
}

function renderedChildren(widgets: [any Widget]) -> [String] {
    var out: [String] = []
    var index = 0
    while index < widgets.count {
        let lines = widgets[index].render()
        var j = 0
        while j < lines.count {
            out.append(lines[j])
            j = j + 1
        }
        index = index + 1
    }
    return out
}

Widget Row() {
    @Content let children: [Widget]

    function render() -> [String] {
        var out: [String] = ["row"]
        let inner = renderedChildren(children)
        var index = 0
        while index < inner.count {
            out.append(inner[index])
            index = index + 1
        }
        return out
    }
}

@Main
function main() {
    var round = 0
    while round < 30 {
        let rendered = Row() {
            Leaf(text = "a")
            Leaf(text = "bb")
            Leaf(text = "ccc")
        }.render()
        var checksum = 0
        var index = 0
        while index < rendered.count {
            checksum = checksum + rendered[index].count
            index = index + 1
        }
        if checksum != 9 {
            print("bad checksum")
            return
        }
        round = round + 1
    }
    print("ok")
    return
}
