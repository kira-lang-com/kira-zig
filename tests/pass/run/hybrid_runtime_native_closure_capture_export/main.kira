// A native-bodied capturing closure is round-tripped native -> runtime -> native:
// `makeAdder` (native) returns a closure capturing `base`; the runtime `main`
// receives it and hands it back to the native `apply` sink. In hybrid mode the
// closure body is stripped from the VM bytecode module, so the runtime->native
// export must recover the capture types from the hybrid manifest and lower the
// captured `base`. Regression guard for the capturing variant of the hybrid
// "runtime closure function could not be resolved" SIGABRT.

@Native
function makeAdder(base: Int) -> (Int) -> Int {
    return { x in
        return x + base
    }
}

@Native
function apply(callback: (Int) -> Int, value: Int) -> Int {
    return callback(value)
}

@Main
function main() {
    let f: (Int) -> Int = makeAdder(10)
    print(apply(move f, 5))
    return
}
