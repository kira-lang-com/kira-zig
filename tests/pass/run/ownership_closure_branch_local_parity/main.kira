// A var closure local reassigned across branches: whichever branch ran, the
// dead value is dropped and the live one survives to the call — the closure
// analogue of the enum F1 branch-reassignment shape.

function makeAdder(base: Int): (Int) -> Int {
    return { n in
        return base + n
    }
}

@Main
function main() {
    var total = 0
    var i = 0
    while i < 1000 {
        var g = makeAdder(1)
        if i - (i / 2) * 2 == 0 {
            g = makeAdder(2)
        } else {
            g = makeAdder(3)
        }
        total = total + g(0)
        i = i + 1
    }
    print(total)
    return
}
