// Leak class #3 regression (the widget-tree shape): type-erased construct
// values are deep values on the native path — the runtime-typed dispatcher
// (kira_capi_dynamic_destroy/clone, switching on the kira_struct_alloc
// type-id header) destroys and copies them through [Node] array elements,
// construct fields, owned params, and returns. Rebuilding the tree 150 times
// must reclaim every node including nested constructs and their strings.

construct Node {
    @Required let label: String
}

Node Leaf {
    let text: String = ""
    let weight: Int = 0

    let label: String {
        text
    }
}

Node Pair {
    @Required let first: Node
    @Required let second: Node

    let label: String {
        "pair"
    }
}

function buildRow(index: Int) -> some Node {
    if index - (index / 2) * 2 == 0 {
        return Leaf(text: "leaf", weight: index)
    }
    return Pair(first: Leaf(text: "a"), second: Leaf(text: "b"))
}

@Main
function main() {
    var total = 0
    var rebuild = 0
    while rebuild < 150 {
        var nodes: [some Node] = []
        var i = 0
        while i < 12 {
            nodes.append(buildRow(i))
            i = i + 1
        }
        for node in nodes {
            let label = node.label
            if label == "leaf" {
                total = total + 1
            }
            if label == "pair" {
                total = total + 2
            }
        }
        rebuild = rebuild + 1
    }
    print(total)
    return
}
