// Returned-closure invariant: a `ret` of an untracked closure source deep-
// clones (kira_capi_closure_clone) and the caller tracks every raw_ptr call
// result as an owned .closure drop — so a factory's closure is freed exactly
// once by the caller and a borrowed source is never double-freed.

function makeAdder(base: Int): (Int) -> Int {
    return { n in
        return base + n
    }
}

// Returns its closure PARAMETER (an untracked borrowed source at `ret`): the
// return path must hand back an independent clone, not the caller-owned block.
function passThrough(f: (Int) -> Int): (Int) -> Int {
    return move f
}

@Main
function main() {
    var total = 0
    var i = 0
    while i < 2000 {
        let add = makeAdder(i)
        let same = passThrough(move add)
        total = total + same(2)
        i = i + 1
    }
    print(total)
    return
}
