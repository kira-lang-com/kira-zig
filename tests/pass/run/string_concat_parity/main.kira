// Regression: String concatenation via `+`. Previously a type error (KSEM013);
// now `+` on two strings concatenates on every backend (VM allocates a heap-
// managed string; LLVM emits malloc + 2x memcpy inline). Asserts vm/llvm/hybrid
// agree, including loop-accumulated strings and equality on concat results.
function greet(name: String) -> String {
    return "hello, " + name
}

@Main
function main() {
    print("a" + "b")                     // ab
    print("" + "x")                      // x
    print("y" + "")                      // y
    print(greet("kira"))                 // hello, kira
    var s = ""
    var i = 0
    while i < 4 {
        s = s + "ab"
        i = i + 1
    }
    print(s)                             // abababab
    print(s == "abababab")               // true
    print(("p" + "q") + ("r" + "s"))     // pqrs
    return
}
