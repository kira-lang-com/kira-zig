// Closure field overwrite drops the replaced block first (store.clos.work:
// destroy old, store fresh clone, self-store guarded) — reassigning a
// callback field must not orphan the previous closure nor double-free on a
// self-store.

struct Slot {
    var tag: Int
    var cb: (Int) -> Int
}

function makeAdder(base: Int): (Int) -> Int {
    return { n in
        return base + n
    }
}

@Main
function main() {
    var slot = Slot { tag: 0, cb: makeAdder(10) }
    var total = 0
    var i = 0
    while i < 2000 {
        slot.cb = makeAdder(i)
        let f = slot.cb
        total = total + f(1)
        i = i + 1
    }
    // Self-store: the field already holds this exact closure value.
    slot.cb = slot.cb
    let g = slot.cb
    total = total + g(1)
    print(total)
    return
}
