// Struct copies deep-clone closure fields (kira_clone_contents_<T> ->
// kira_capi_closure_clone): each copy owns an independent block, both are
// destroyed with their struct, and neither call dangles after the other copy
// is dropped.

struct Slot {
    var tag: Int
    var cb: (Int) -> Int
}

function makeAdder(base: Int): (Int) -> Int {
    return { n in
        return base + n
    }
}

function firstOf(a: Slot, b: Slot) -> Int {
    let f = a.cb
    let g = b.cb
    return f(1) + g(2) + a.tag + b.tag
}

@Main
function main() {
    var total = 0
    var i = 0
    while i < 1000 {
        var original = Slot { tag: i, cb: makeAdder(i) }
        var copy = original
        copy.tag = copy.tag + 1
        copy.cb = makeAdder(i + 1)
        total = total + firstOf(move original, move copy)
        i = i + 1
    }
    print(total)
    return
}
