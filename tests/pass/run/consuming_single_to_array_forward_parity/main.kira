// EdPanelFill/SurfaceBox regression: a body-wrapper with a SINGLE @Content
// Widget field forwards it into a widget whose @Content is a [Widget] ARRAY —
// the single content becomes array element 0 (`[content]`). That Any field
// read into an owned array element must partial-move out of self, or self's
// teardown and the array-widget's drain both free the same shell. Leak-gated.

construct Widget {
    @Required let body: Widget

    @Consuming
    function render() -> [String] {
        return body.render()
    }
}

Widget Leaf(text: String) {
    function render() -> [String] {
        return [text]
    }
}

function renderedChildren(widgets: [any Widget]) -> [String] {
    var out: [String] = []
    var index = 0
    while index < widgets.count {
        let lines = widgets[index].render()
        var j = 0
        while j < lines.count {
            out.append(lines[j])
            j = j + 1
        }
        index = index + 1
    }
    return out
}

// Array-content widget (SurfaceBox shape).
Widget Box() {
    @Content let children: [Widget]

    function render() -> [String] {
        var out: [String] = ["box"]
        let inner = renderedChildren(children)
        var index = 0
        while index < inner.count {
            out.append(inner[index])
            index = index + 1
        }
        return out
    }
}

// Single-content wrapper (EdPanelFill shape): forwards its one content into a
// Box whose content is an array — `content` becomes `[content]`.
Widget Fill() {
    @Content let content: Widget

    body {
        Box() {
            content
        }
    }
}

@Main
function main() {
    var round = 0
    while round < 30 {
        let rendered = Fill() {
            Leaf(text = "hi")
        }.render()
        var checksum = 0
        var index = 0
        while index < rendered.count {
            checksum = checksum + rendered[index].count
            index = index + 1
        }
        // "box"=3 + "hi"=2 = 5
        if checksum != 5 {
            print("bad checksum")
            return
        }
        round = round + 1
    }
    print("ok")
    return
}
