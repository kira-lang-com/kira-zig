//
//   KIRA_PURE_TEST=1 kira test --backend hybrid tests-kik/corpus/hybrid-bridge
//
// main is trivial; the driver synthesized in test mode is the real entry.
// Each app/<theme>/ module contributes Test declarations with a unique prefix.

import Foundation

@Main
@Runtime
function main() {
    return
}
