// Cx2SlotByTypeTests.kira — Construct 2.0 item 4: slot-by-type.
// A construct-form field typed `some X` / `[some X]` IS a caller-provided child
// slot WITHOUT any `@Content` annotation. Slots are filled by the trailing
// content block at the construction site; filling a slot via a constructor
// parens argument is rejected (KSEM162, covered in fail-corpus/semantics-a).
// No `import Foundation` — package-wide Test/Result/TestFailure already available.
// PREFIX: cx2Slot / Cx2Slot (all top-level names).

construct Cx2SlotWidget {
    @Required let body: Cx2SlotWidget

    function render() -> [String] {
        return body.render()
    }
}

Cx2SlotWidget Cx2SlotText(text: String) {
    function render() -> [String] {
        return [text]
    }
}

function cx2SlotFlatten(children: borrow [some Cx2SlotWidget]) -> [String] {
    var labels: [String] = []
    var i = 0
    while i < children.count {
        let rendered = children[i].render()
        var j = 0
        while j < rendered.count {
            labels.append(rendered[j])
            j = j + 1
        }
        i = i + 1
    }
    return labels
}

function cx2SlotPipe(labels: borrow [String]) -> String {
    var out = ""
    var i = 0
    while i < labels.count {
        if i > 0 {
            out = out + "|"
        }
        out = out + labels[i]
        i = i + 1
    }
    return out
}

// `[some Cx2SlotWidget]` list slot — NO @Content annotation. Overriding `render`
// discharges the family's `@Required let body` (terminal-member rule).
Cx2SlotWidget Cx2SlotRow() {
    let children: [some Cx2SlotWidget]

    function render() -> [String] {
        return cx2SlotFlatten(children)
    }
}

// Single `some Cx2SlotWidget` slot — NO @Content annotation.
Cx2SlotWidget Cx2SlotFrame() {
    let child: some Cx2SlotWidget

    function render() -> [String] {
        return child.render()
    }
}

Test Cx2SlotListFilledByBlock {
    test {
        let row = Cx2SlotRow() {
            Cx2SlotText("a")
            Cx2SlotText("b")
        }
        return cx2SlotPipe(row.render())
    }
    expect { let e: Result<String, TestFailure> = .Ok("a|b"); return e }
}

Test Cx2SlotSingleFilledByBlock {
    test {
        let frame = Cx2SlotFrame() {
            Cx2SlotText("solo")
        }
        return cx2SlotPipe(frame.render())
    }
    expect { let e: Result<String, TestFailure> = .Ok("solo"); return e }
}

Test Cx2SlotListWithForLoop {
    test {
        let items: [String] = ["x", "y", "z"]
        let row = Cx2SlotRow() {
            For(item in items) {
                Cx2SlotText(item)
            }
        }
        return cx2SlotPipe(row.render())
    }
    expect { let e: Result<String, TestFailure> = .Ok("x|y|z"); return e }
}
