import Foundation

// WarTests.kira — migrated from tests/pass/run/widget_any_return_dispatch.
// PREFIX: war / War (all top-level names use this prefix, including the extend
// method, so it cannot collide with other files' extends).
// This file imports Foundation (imports are file-scoped); Test/Result/TestFailure already available.

// ---------------------------------------------------------------------------
// widget_any_return_dispatch
// ---------------------------------------------------------------------------
// Returning `some Widget` from a helper must preserve dynamic dispatch.
// Original printed `identity(Text(text: "returned")).describe()` (stdout
// "returned").

construct WarNode {
    @Required let label: String
}

WarNode WarTextNode {
    let text: String = ""

    let label: String {
        text
    }
}

construct WarWidget {
    @Required let body: WarWidget
    let node: WarNode { body.node }
}

WarWidget WarText {
    let text: String = ""

    let node: WarNode {
        WarTextNode(text: text)
    }
}

extend WarWidget {
    function warDescribe() -> String {
        return self.node.label
    }
}

function warIdentity(widget: some WarWidget) -> some WarWidget {
    return widget
}

Test WarAnyReturnDispatch {
    test {
        return warIdentity(WarText(text: "returned")).warDescribe()
    }
    expect { let e: Result<String, TestFailure> = .Ok("returned"); return e }
}
