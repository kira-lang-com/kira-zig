// ---------------------------------------------------------------------------
// inheritance_imported_parent_parity
// ---------------------------------------------------------------------------

class ImdChild extends Support.ImdImportedBase {
    override let base = 33

    function total(): I64 {
        return ImdImportedBase.baseValue() + ImdImportedBase.base
    }
}

Test ImdChildBaseValue {
    test {
        let child: ImdChild = ImdChild()
        return child.baseValue()
    }
    expect { let e: Result<I64, TestFailure> = .Ok(33); return e }
}

Test ImdChildBaseField {
    test {
        let child: ImdChild = ImdChild()
        return child.base
    }
    expect { let e: Result<I64, TestFailure> = .Ok(33); return e }
}

Test ImdChildTotal {
    test {
        let child: ImdChild = ImdChild()
        return child.total()
    }
    expect { let e: Result<I64, TestFailure> = .Ok(66); return e }
}

// ---------------------------------------------------------------------------
// inheritance_multi_parent_parity
// ---------------------------------------------------------------------------

class ImeLeft {
    let value: I64 = 10

    function doubled(): I64 {
        return value * 2
    }
}

class ImeRight {
    let bonus: I64 = 5

    function tripled(): I64 {
        return bonus * 3
    }
}

class ImeChild extends ImeLeft, ImeRight {
    override let value = 11
    override let bonus = 7

    function total(): I64 {
        return ImeLeft.doubled() + ImeRight.tripled() + ImeLeft.value + ImeRight.bonus
    }
}

Test ImeChildDoubled {
    test {
        let child: ImeChild = ImeChild()
        return child.doubled()
    }
    expect { let e: Result<I64, TestFailure> = .Ok(22); return e }
}

Test ImeChildTripled {
    test {
        let child: ImeChild = ImeChild()
        return child.tripled()
    }
    expect { let e: Result<I64, TestFailure> = .Ok(21); return e }
}

Test ImeChildFields {
    test {
        let child: ImeChild = ImeChild()
        return child.value * 100 + child.bonus
    }
    expect { let e: Result<I64, TestFailure> = .Ok(1107); return e }
}

Test ImeChildTotal {
    test {
        let child: ImeChild = ImeChild()
        return child.total()
    }
    expect { let e: Result<I64, TestFailure> = .Ok(61); return e }
}
