// ImxTests.kira — migrated corpus cases from tests/pass/run/{imports,imported_*,inheritance_*}.
// PREFIXES: imx/Imx (imports), ima/Ima (imported_instance_method_parity),
// imb/Imb (imported_library_class_metadata_parity), imc/Imc (imported_namespace_parity),
// imd/Imd (inheritance_imported_parent_parity), ime/Ime (inheritance_multi_parent_parity).
// No `import Foundation` — package-wide Test/Result/TestFailure/print already available.
// The sibling module app/support.kira is imported qualified, exactly like the legacy
// cases' `import support as Support`.

import support as Support

// ---------------------------------------------------------------------------
// imports — the import statement resolving (plus local helper arithmetic)
// ---------------------------------------------------------------------------

function imxHelper() -> Int {
    let first = 1
    let second = 2
    return first + second
}

Test ImxImportsResolve {
    test { return imxHelper() }
    expect { let e: Result<Int, TestFailure> = .Ok(3); return e }
}

