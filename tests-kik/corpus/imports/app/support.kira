function imxStub() {
    return
}

// ---------------------------------------------------------------------------
// imported_instance_method_parity
// ---------------------------------------------------------------------------

class ImaApplication {
    let value: I64 = 7

    function run(): I64 {
        return self.value
    }
}

// ---------------------------------------------------------------------------
// imported_library_class_metadata_parity
// ---------------------------------------------------------------------------

class ImbNode {
    let value: I64 = 5

    function render(): I64 {
        return self.value
    }
}

class ImbLabel extends ImbNode {
    override let value: I64 = 11
}

struct ImbNodeConfig {
    let node: ImbNode
}

function imbMakeConfig(): ImbNodeConfig {
    return ImbNodeConfig {
        node: ImbLabel()
    }
}

