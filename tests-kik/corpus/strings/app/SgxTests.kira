    expect { let e: Result<Int, TestFailure> = .Ok(4); return e }
}

Test SgxCountSubtitle {
    test {
        let subtitle = "UI FOUNDATION"
        return subtitle.count
    }
    expect { let e: Result<Int, TestFailure> = .Ok(13); return e }
}

// ---------------------------------------------------------------------------
// string_equality_parity
// ---------------------------------------------------------------------------

Test SgxEqAlphaAlpha {
    test { return "alpha" == "alpha" }
    expect { let e: Result<Bool, TestFailure> = .Ok(true); return e }
}

Test SgxEqAlphaBeta {
    test { return "alpha" == "beta" }
    expect { let e: Result<Bool, TestFailure> = .Ok(false); return e }
}

Test SgxNeqAlphaBeta {
    test { return "alpha" != "beta" }
    expect { let e: Result<Bool, TestFailure> = .Ok(true); return e }
}

Test SgxEqEmptyEmpty {
    test { return "" == "" }
    expect { let e: Result<Bool, TestFailure> = .Ok(true); return e }
}

Test SgxEqPrefixMismatch {
    test { return "a" == "ab" }
    expect { let e: Result<Bool, TestFailure> = .Ok(false); return e }
}

Test SgxEqPickComputed {
    test { return sgxPick(0) == "alpha" }
    expect { let e: Result<Bool, TestFailure> = .Ok(true); return e }
}

Test SgxEqPickPick {
    test { return sgxPick(1) == sgxPick(1) }
    expect { let e: Result<Bool, TestFailure> = .Ok(true); return e }
}

