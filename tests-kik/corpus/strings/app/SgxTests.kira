// ---------------------------------------------------------------------------

Test SgxCallTempCountHello {
    test { return sgxPickWord(0).count }
    expect { let e: Result<Int, TestFailure> = .Ok(5); return e }
}

Test SgxCallTempCountWorldwide {
    test { return sgxPickWord(1).count }
    expect { let e: Result<Int, TestFailure> = .Ok(9); return e }
}

