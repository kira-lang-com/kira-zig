Package KikCorpusFfiDynamic {
    let version = "0.1.0"
    let kind = .App
    let defaults = Defaults { executionMode: .Vm, buildTarget: .Host }
    let nativeLibraries = [
        NativeLibrary {
            name: "ffimath",
            linkMode: .Dynamic,
            headers: Headers { entrypoint: "NativeLibs/ffimath.h", includeDirs: ["NativeLibs"] },
            sources: ["NativeLibs/ffimath.c"]
        }
    ]
    let tests = Tests { backends: [.Vm], phase: .Both }
}
