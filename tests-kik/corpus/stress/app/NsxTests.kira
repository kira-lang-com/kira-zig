import Foundation

// NsxTests.kira
// Migrated from tests/pass/run/large_nested_struct_copy_source_must_be_pointer_regression.
// All top-level names use prefix nsx / Nsx. This file imports Foundation (imports are file-scoped);
// every file that uses Foundation symbols must import it explicitly.
// Regression: copying a nested struct out of an array element must read
// through a pointer to the element, not from a stale materialized temporary;
// mutations of the copies must never write back into the grid.

// ---------------------------------------------------------------------------
// large_nested_struct_copy_source_must_be_pointer_regression
// ---------------------------------------------------------------------------

struct NsxLeaf {
    var id: Int
    var weight: Int
}

struct NsxCell {
    var primary: NsxLeaf
    var secondary: NsxLeaf
}

struct NsxRow {
    var cells: [NsxCell]
    var rowWeight: Int
}

struct NsxGrid {
    var rows: [NsxRow]
    var version: Int
}

function nsxMakeCell(base: Int) -> NsxCell {
    return NsxCell {
        primary: NsxLeaf { id: base, weight: base * 10 },
        secondary: NsxLeaf { id: base + 1, weight: base * 10 + 5 }
    }
}

function nsxMakeGrid() -> NsxGrid {
    return NsxGrid {
        rows: [
            NsxRow { cells: [nsxMakeCell(1), nsxMakeCell(2), nsxMakeCell(3)], rowWeight: 100 },
            NsxRow { cells: [nsxMakeCell(4), nsxMakeCell(5), nsxMakeCell(6)], rowWeight: 200 },
            NsxRow { cells: [nsxMakeCell(7), nsxMakeCell(8), nsxMakeCell(9)], rowWeight: 300 }
        ],
        version: 42
    }
}

function nsxCellScore(cell: borrow NsxCell) -> Int {
    return cell.primary.id * 1000 + cell.primary.weight * 100 + cell.secondary.id * 10 + cell.secondary.weight
}

function nsxRowScore(row: borrow NsxRow) -> Int {
    var score = row.rowWeight
    var i = 0
    while i < 3 {
        score = score + nsxCellScore(row.cells[i])
        i = i + 1
    }
    return score
}

function nsxMutateCopy(cell: borrow NsxCell, delta: Int) -> NsxCell {
    var copy = cell
    copy.primary.weight = copy.primary.weight + delta
    copy.secondary.id = copy.secondary.id + 20
    return copy
}

function nsxReturnedNestedCopy(grid: borrow NsxGrid, rowIndex: Int, cellIndex: Int) -> NsxCell {
    let row = grid.rows[rowIndex]
    let cell = row.cells[cellIndex]
    return nsxMutateCopy(cell, 7)
}

function nsxGridScore(grid: borrow NsxGrid) -> Int {
    var score = grid.version
    var i = 0
    while i < 3 {
        score = score + nsxRowScore(grid.rows[i])
        i = i + 1
    }
    return score
}

// The original @Main body; `which` selects which printed value to return.
function nsxScenario(which: Int) -> Int {
    var grid = nsxMakeGrid()
    let originalMiddle = grid.rows[1].cells[1]
    var localCopy = grid.rows[1].cells[1]
    localCopy.primary.weight = localCopy.primary.weight + 99
    localCopy.secondary.weight = localCopy.secondary.weight + 33

    let returned = nsxReturnedNestedCopy(grid, 2, 1)
    var replacement = returned
    replacement.primary.id = replacement.primary.id + 100
    let rowsCopy = grid.rows[1]

    if which == 0 {
        return nsxCellScore(originalMiddle)
    }
    if which == 1 {
        return nsxCellScore(localCopy)
    }
    if which == 2 {
        return nsxCellScore(grid.rows[1].cells[1])
    }
    if which == 3 {
        return nsxCellScore(returned)
    }
    if which == 4 {
        return nsxCellScore(replacement)
    }
    if which == 5 {
        return nsxRowScore(rowsCopy)
    }
    return nsxGridScore(grid)
}

Test NsxOriginalMiddleCell {
    test { return nsxScenario(0) }
    expect { let e: Result<Int, TestFailure> = .Ok(10115); return e }
}

Test NsxLocalCopyMutated {
    test { return nsxScenario(1) }
    expect { let e: Result<Int, TestFailure> = .Ok(20048); return e }
}

Test NsxGridCellUntouched {
    // Mutating localCopy must not have written back into the grid.
    test { return nsxScenario(2) }
    expect { let e: Result<Int, TestFailure> = .Ok(10115); return e }
}

Test NsxReturnedNestedCopy {
    test { return nsxScenario(3) }
    expect { let e: Result<Int, TestFailure> = .Ok(17075); return e }
}

Test NsxReplacementMutated {
    // Mutating replacement must not have written back into `returned`.
    test { return nsxScenario(4) }
    expect { let e: Result<Int, TestFailure> = .Ok(117075); return e }
}

Test NsxRowCopyScore {
    test { return nsxScenario(5) }
    expect { let e: Result<Int, TestFailure> = .Ok(30545); return e }
}

Test NsxGridScoreIntact {
    test { return nsxScenario(6) }
    expect { let e: Result<Int, TestFailure> = .Ok(91677); return e }
}
