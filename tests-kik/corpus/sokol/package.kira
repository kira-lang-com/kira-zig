            sources: ["../../../third_party/sokol/sokol_gfx_impl.c"],
            autobind: Autobind {
                module: "sokol_gfx",
                functions: ["sg_setup", "sg_isvalid", "sg_shutdown"],
                structs: ["sg_desc"]
            }
        }
    ]
    let tests = Tests { backends: [.Hybrid], phase: .Both }
