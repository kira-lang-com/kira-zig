        NativeLibrary {
            name: "sokol",
            linkMode: .Static,
            headers: Headers { entrypoint: "../../../third_party/sokol/sokol_bindings.h", includeDirs: ["../../../third_party/sokol"], defines: ["SOKOL_NO_ENTRY", "SOKOL_GLCORE"] },
            sources: ["../../../third_party/sokol/sokol_impl.m"],
