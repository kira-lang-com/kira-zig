import UI as Kit

// Bare-callee type precedence is package-symmetric (d381d32): a bare call whose
// name matches a visible imported type prefers type construction, so BOTH the
// unqualified `Card(...)` and the alias-qualified `Kit.Card(...)` resolve to the
// imported widget. This used to be a fail case (unknown call target for the
// unqualified form) before that precedence change.

/// Qualified imported documentation.
Widget DashboardShell() {
    content {
        Card("Global")
        Kit.Card("Qualified")
    }

    onAppear() {
        return;
    }
}

@Main
function entry() {
    return;
}
