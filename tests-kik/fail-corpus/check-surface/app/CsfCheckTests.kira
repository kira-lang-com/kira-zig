// --- callback_syntax_and_function_types (tests/pass/check/callback_syntax_and_function_types)
FailTest CsfCallbackSyntaxAndFunctionTypes {
    backends { hybrid vm }
    source {
function sink(value: Int) {
    print(value);
    return;
}

function register(handler: (Int) -> Void) {
    return;
}

@Main
function main() {
    let callback: (Int) -> Void = sink;
    register { value in
        sink(value);
    }
    callback(1);
    return;
}
    }
    expect { let e: Result<Int, TestFailure> = .Ok(1); return e }
}

// --- construct_content_channels (tests/pass/check/construct_content_channels)
FailTest CsfConstructContentChannels {
    backends { hybrid vm }
    source {
// Construct 2.0: a construct's child content is a slot field typed `some X` (one child) or
// `[some X]` (many). Slots are filled by the trailing content block at the construction site,
// replacing the old named-channel `content { head { accepts ...; count ... } }` schema.

construct WebElement {
    @Required let body: WebElement

    function render() -> [String] {
        return body.render()
    }
}

WebElement Title(text: String) {
    function render() -> [String] {
        return [text]
    }
}

WebElement Document() {
    let children: [some WebElement]

    function render() -> [String] {
        return children[0].render()
    }
}

@Main
function main() {
    let page = Document() {
        Title("Home")
        Title("Welcome")
    }
    return
}
    }
    expect { let e: Result<Int, TestFailure> = .Ok(1); return e }
}

// --- construct_content_composition (tests/pass/check/construct_content_composition)
FailTest CsfConstructContentComposition {
    backends { hybrid vm }
    source {
// Construct 2.0: content composition is expressed by nesting slot-typed widgets inside a
// `body { ... }` builder block — a parent composes children by constructing them in its body.
// There are no `refine` / `project` / `passthrough` / `sealed` content directives.

construct WebElement {
    @Required let body: WebElement

    function render() -> [String] {
        return body.render()
    }
}

WebElement Text(text: String) {
    function render() -> [String] {
        return [text]
    }
}

WebElement Stack() {
    let children: [some WebElement]

    function render() -> [String] {
        return children[0].render()
    }
}

WebElement Article() {
    body {
        Stack() {
            Text("hello")
        }
    }
}

@Main
function main() {
    let article = Article()
    return
}
    }
    expect { let e: Result<Int, TestFailure> = .Ok(1); return e }
}

// --- construct_extends (tests/pass/check/construct_extends)
FailTest CsfConstructExtends {
    backends { vm llvm hybrid }
    source {
// Constructs form declaration families that can inherit from other constructs with
// `extends` (not `:` and not `extend`). The local inheritance graph may reference
// constructs declared later in the file and may list multiple direct parents, as long
// as it stays acyclic.

construct WebElement {
}

construct Drawable {
}

// Multiple direct parents.
construct Surface extends WebElement, Drawable {
}

// Forward reference: `Route` extends `Surface` which is declared above, and `Page`
// (declared below) extends `Route` — registration is order-independent.
construct Route extends Surface {
}

construct Page extends Route {
}

@Main
function main() {
    return
}
    }
    expect { let e: Result<Int, TestFailure> = .Ok(1); return e }
}

// --- construct_properties (tests/pass/check/construct_properties)
FailTest CsfConstructProperties {
    backends { hybrid vm }
    source {
// Construct 2.0: a construct's caller-provided values are `@Required let` fields (every
// construct-backed declaration must provide them) and `let field = value` defaults (optional,
// overridable). Fields are inherited through `extends`. A declaration provides required values
// as constructor parameters — there is no `properties { ... }` schema section.

construct WebElement {
    let id: String = "element"
}

construct Route extends WebElement {
    @Required let path: String
    let title: String = "untitled"
}

Route Home(path: String) {
}

@Main
function main() {
    let home = Home(path = "/")
    return
}
    }
    expect { let e: Result<Int, TestFailure> = .Ok(1); return e }
}

// --- construct_required_functions (tests/pass/check/construct_required_functions)
FailTest CsfConstructRequiredFunctions {
    backends { hybrid vm }
    source {
// A construct's `requires { function ... }` block lists functions that its first concrete
// declaration must implement. Declarations inherit implementations from a parent declaration
// and may override them. The inheritance graph spans construct->construct, declaration->construct,
// and declaration->declaration.

construct Drawable {
    requires {
        function draw()
    }
}

// First concrete child of `Drawable`: must implement draw().
Drawable Sprite {
    function draw() {
    }
}

// Inherits draw() from the `Sprite` declaration — valid without re-implementing.
Sprite Player {
}

// Overrides draw() — valid.
Sprite AnimatedPlayer {
    function draw() {
    }
}

@Main
function main() {
    return
}
    }
    expect { let e: Result<Int, TestFailure> = .Ok(1); return e }
}

