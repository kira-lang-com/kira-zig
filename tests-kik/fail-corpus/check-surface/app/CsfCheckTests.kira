// --- annotation_definitions (tests/pass/check/annotation_definitions)
FailTest CsfAnnotationDefinitions {
    backends { hybrid vm }
    source {
annotation State {
}

annotation Attribute {
    parameters {
        index: Int
    }
}

annotation InputMapping {
    parameters {
        priority: Int = 0
        blocksLowerPriorityMappings: Bool = false
    }
}

construct Widget {
    annotations {
        @State;
        @Attribute;
        @InputMapping;
    }
}

Widget Button() {
    @State
    let isPressed: Bool = false;

    @Attribute(0)
    let position: Float = 0.0;

    @InputMapping
    let mapping: Int = 1;

    content {
    }
}

@Main
function entry() {
    return;
}
    }
    expect { let e: Result<Int, TestFailure> = .Ok(1); return e }
}

