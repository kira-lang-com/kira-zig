// --- widget_content_composition (tests/pass/check/widget_content_composition)
FailTest CsfWidgetContentComposition {
    backends { vm llvm hybrid }
    source {
// `@Content` fields are caller-provided children. A trailing `{ ... }` block on a construction
// fills them: a single `Widget` field takes one child, a `[Widget]` field takes many in order,
// and multiple `@Content` fields are filled by name. Field names are the channel names.

construct Widget {
    @Required let body: Widget
    let node: Node { body.node }
}

Widget Text {
    let text: String = ""
    let node: Node { TextNode(text: text) }
}

Widget VStack {
    @Content let children: [Widget]
    let node: Node { VStackNode() }
}

Widget HStack {
    @Content let children: [Widget]
    let node: Node { HStackNode() }
}

Widget Padding {
    @Content let child: Widget
    let node: Node { PaddingNode() }
}

Widget Dialog {
    @Content let header: Widget
    @Content let content: Widget
    let node: Node { DialogNode() }
}

// Nested composition: list content, single content, and named fills, all in source order.
Widget Screen {
    let body: Widget {
        VStack {
            Text(text: "title")
            HStack {
                Text(text: "left")
                Text(text: "right")
            }
            Padding {
                Text(text: "inner")
            }
            Dialog {
                header {
                    Text(text: "Title")
                }
                content {
                    Text(text: "Message")
                }
            }
        }
    }
}

@Main
function main() {
    return
}
    }
    expect { let e: Result<Int, TestFailure> = .Ok(1); return e }
}

// --- widget_extend_modifier (tests/pass/check/widget_extend_modifier)
FailTest CsfWidgetExtendModifier {
    backends { vm llvm hybrid }
    source {
// `extend C { ... }` adds fluent modifier functions to a construct family. Modifiers return the
// family type and are used as call chains (`Text(...).padding(amount: 8)`), distinct from the
// core Widget->Node bridge.

construct Widget {
    @Required let body: Widget
    let node: Node { body.node }
}

Widget Text {
    let text: String = ""
    let node: Node { TextNode(text: text) }
}

Widget Padding {
    let amount: Float = 16
    @Content let child: Widget
    let node: Node { PaddingNode(amount: amount) }
}

extend Widget {
    function padding(amount: Float) -> Widget {
        Padding(amount: amount) {
            self
        }
    }
}

Widget Button {
    let title: String = ""
    let body: Widget {
        Text(text: title).padding(amount: 8)
    }
}

@Main
function main() {
    return
}
    }
    expect { let e: Result<Int, TestFailure> = .Ok(1); return e }
}

// --- widget_required_and_node_bridge (tests/pass/check/widget_required_and_node_bridge)
FailTest CsfWidgetRequiredAndNodeBridge {
    backends { vm llvm hybrid }
    source {
// The SwiftUI-style construct surface: `@Required` marks required construct members directly,
// and `let node: Node { ... }` is the typed Widget->Node bridge.
//
// * `construct Node` requires two functions (test: @Required function requirement).
// * `construct Widget` requires the `body` field and supplies a default `node = body.node`
//   (test: @Required field requirement + default computed member).
// * A composite widget provides `body` and inherits the default `node`.
// * A primitive widget provides `node` directly and omits `body` (terminal rule), without
//   triggering infinite `body` resolution.

construct Node {
    @Required function measure() -> Int
    @Required function place() -> Int
}

construct Widget {
    @Required let body: Widget
    let node: Node { body.node }
}

// Concrete Node declaration: must implement every @Required function.
Node TextNode {
    function measure() -> Int {
        return 0
    }
    function place() -> Int {
        return 0
    }
}

// Primitive/terminal widget: provides `node`, omits `body`. The explicit `node` discharges the
// required `body`, and resolution stops here (no infinite body recursion).
Widget Text {
    let text: String = ""

    let node: Node {
        TextNode()
    }
}

// Composite widget: provides `body`, inherits the default `node = body.node`.
Widget Button {
    let title: String = ""

    let body: Widget {
        Text(text: title)
    }
}

@Main
function main() {
    return
}
    }
    expect { let e: Result<Int, TestFailure> = .Ok(1); return e }
}

