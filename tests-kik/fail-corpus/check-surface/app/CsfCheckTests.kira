// --- field_override_enum_payload_defaults (tests/pass/check/field_override_enum_payload_defaults)
FailTest CsfFieldOverrideEnumPayloadDefaults {
    backends { hybrid vm llvm }
    source {
struct Color {
    let r: F32 = 1.0
}

struct GlowPayload {
    let color: Color = Color {}
    let radius: Int = 4
}

enum Paint {
    Flat
    Glow(GlowPayload)
}

class Surface {
    let paint: Paint = .Flat
    let effects: [Paint] = []
}

class Card extends Surface {
    override let paint: Paint = .Flat
    override let effects: [Paint] = [.Glow(GlowPayload { color: Color { r: 0.5 } })]
}

@Main
function main() {
    let card = Card()
    return
}
    }
    expect { let e: Result<Int, TestFailure> = .Ok(1); return e }
}

// --- game_item_generated (tests/pass/check/game_item_generated)
FailTest CsfGameItemGenerated {
    backends { hybrid vm }
    source {
capability Serializable {
    generated {
        overridable function transportFormat(): String {
            return "ktl"
        }

        function toJson(): String {
            return "json"
        }
    }
}

annotation GameItem {
    targets: class
    uses Serializable

    generated {
        overridable function displayName(): String {
            return "item"
        }
    }
}

struct Position {
    let x: Float = 0.0
    let y: Float = 0.0
    let z: Float = 0.0
}

class GameData {
    let createdAt: Int = 0

    function debugLabel(): String {
        return "GameData"
    }
}

@GameItem
class PlayerData extends GameData {
    let name: String = "DefaultName"
    let level: Int = 1
    let position: Position

    override function transportFormat(): String {
        return "ktl+player"
    }

    override function displayName(): String {
        return name
    }
}

@Main
function entry() {
    return
}
    }
    expect { let e: Result<Int, TestFailure> = .Ok(1); return e }
}

// --- inheritance_parent_qualification (tests/pass/check/inheritance_parent_qualification)
FailTest CsfInheritanceParentQualification {
    backends { hybrid vm }
    source {
class Left {
    let value: I64 = 1

    function read(): I64 {
        return value
    }
}

class Right {
    let value: I64 = 2

    function read(): I64 {
        return value
    }
}

class Child extends Left, Right {
    function combine(): I64 {
        return Left.read() + Right.read() + Left.value + Right.value
    }
}

@Main
function entry() {
    let child: Child = Child()
    child.combine()
    return
}
    }
    expect { let e: Result<Int, TestFailure> = .Ok(1); return e }
}

