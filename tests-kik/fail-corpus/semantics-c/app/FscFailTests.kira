// --- widget_dynamic_missing_method (tests/fail/semantics/widget_dynamic_missing_method)
FailTest FscWidgetDynamicMissingMethod {
    backends { vm llvm hybrid }
    source {
        construct Widget {
            @Required let body: Widget
            let node: Node { body.node }
        }

        construct Node {
        }

        Widget Text {
            let node: Node {
                TextNode()
            }
        }

        Widget Spacer {
        }

        Node TextNode {
        }

        function show(widget: some Widget) {
            widget.node
        }

        @Main
        function main() {
            show(Text())
            return
        }
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM066")); return e }
}

// --- widget_extend_unknown_target (tests/fail/semantics/widget_extend_unknown_target)
FailTest FscWidgetExtendUnknownTarget {
    backends { hybrid vm }
    source {
        // `extend` must target a known construct family.
        extend NoSuchConstruct {
            function foo() -> Int {
                return 0
            }
        }

        @Main
        function main() {
            return
        }
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM146")); return e }
}

// --- widget_missing_body_and_node (tests/fail/semantics/widget_missing_body_and_node)
FailTest FscWidgetMissingBodyAndNode {
    backends { hybrid vm }
    source {
        // A widget must provide `body` (and inherit the default `node`) or provide `node` directly.
        // `Broken` provides neither, so the required `body` member cannot be satisfied.

        construct Widget {
            @Required let body: Widget
            let node: Node { body.node }
        }

        Widget Broken {
            let title: String = ""
        }

        @Main
        function main() {
            return
        }
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM140")); return e }
}
