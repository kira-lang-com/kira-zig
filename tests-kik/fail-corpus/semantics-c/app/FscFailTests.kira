// --- widget_body_self_recursion (tests/fail/semantics/widget_body_self_recursion)
FailTest FscWidgetBodySelfRecursion {
    backends { hybrid vm }
    source {
        // A widget that defines `body` as itself, without overriding the default `node = body.node`,
        // would resolve forever (`Loop.node -> body.node -> Loop.node -> ...`). It is rejected.

        construct Widget {
            @Required let body: Widget
            let node: Node { body.node }
        }

        Widget Loop {
            let body: Widget {
                Loop()
            }
        }

        @Main
        function main() {
            return
        }
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM141")); return e }
}

// --- widget_content_ambiguous (tests/fail/semantics/widget_content_ambiguous)
FailTest FscWidgetContentAmbiguous {
    backends { hybrid vm }
    source {
        construct Widget {
            @Required let body: Widget
            let node: Node { body.node }
        }
        Widget Text {
            let text: String = ""
            let node: Node { TextNode(text: text) }
        }
        Widget Padding {
            @Content let child: Widget
            let node: Node { PaddingNode() }
        }
        Widget VStack {
            @Content let children: [Widget]
            let node: Node { VStackNode() }
        }
        Widget Dialog {
            @Content let header: Widget
            @Content let content: Widget
            let node: Node { DialogNode() }
        }
        Widget Screen {
            let body: Widget {
                Dialog { Text(text: "a") }
            }
        }
        @Main
        function main() { return }
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM144")); return e }
}

