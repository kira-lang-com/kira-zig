// --- unknown_annotation_parameter (tests/fail/semantics/unknown_annotation_parameter)
FailTest FscUnknownAnnotationParameter {
    backends { hybrid vm }
    source {
        annotation Attribute {
            parameters {
                index: Int
            }
        }

        construct Widget {
            annotations {
                @Attribute;
            }
        }

        Widget Button() {
            @Attribute(offset: 0)
            let position: Float = 0.0;

            content {
            }
        }

        @Main
        function entry() {
            return;
        }
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM066")); return e }
}

