// FscFailTests.kira
// Migrated compile-failure cases from tests/fail/semantics (slice: dirs 81-103,
// sorted). Each legacy main.kira is inlined VERBATIM in its FailTest source block.
// All FailTest names use the Fsc prefix.
//
// Manifest (legacy case -> FailTest name -> expected Compile code):
//   ownership_returned_borrow_reserved      -> FscOwnershipReturnedBorrowReserved   KSEM112
//   ownership_use_after_move                -> FscOwnershipUseAfterMove             KSEM107
//   some_requires_construct                 -> FscSomeRequiresConstruct             KSEM097
//   trailing_callback_not_accepted          -> FscTrailingCallbackNotAccepted       KSEM081
//   trailing_callback_parameter_mismatch    -> FscTrailingCallbackParameterMismatch KSEM083
//   try_non_result                          -> FscTryNonResult                      KSEM134
//   try_outside_attempt                     -> FscTryOutsideAttempt                 KSEM133
//   typed_float_initializer_requires_float  -> FscTypedFloatInitializerRequiresFloat KSEM085
//   undeclared_construct_annotation         -> FscUndeclaredConstructAnnotation     KSEM063
//   unknown_annotation_parameter            -> FscUnknownAnnotationParameter        KSEM066
//   unknown_struct_literal_field            -> FscUnknownStructLiteralField         KSEM082
//   unresolved_import                       -> FscUnresolvedImport                  KSEM032
//   unresolved_namespace                    -> FscUnresolvedNamespace               KSEM027
//   use_before_initialization               -> FscUseBeforeInitialization           KSEM086
//   widget_body_self_recursion              -> FscWidgetBodySelfRecursion           KSEM141
//   widget_content_ambiguous                -> FscWidgetContentAmbiguous            KSEM144
//   widget_content_count_empty              -> FscWidgetContentCountEmpty           KSEM143
//   widget_content_count_two                -> FscWidgetContentCountTwo             KSEM143
//   widget_content_no_field                 -> FscWidgetContentNoField              KSEM142
//   widget_content_non_widget               -> FscWidgetContentNonWidget            KSEM145
//   widget_dynamic_missing_method           -> FscWidgetDynamicMissingMethod        KSEM066
//   widget_extend_unknown_target            -> FscWidgetExtendUnknownTarget         KSEM146
//   widget_missing_body_and_node            -> FscWidgetMissingBodyAndNode          KSEM140

// --- ownership_returned_borrow_reserved (tests/fail/semantics/ownership_returned_borrow_reserved)
FailTest FscOwnershipReturnedBorrowReserved {
    backends { hybrid vm llvm }
    source {
        struct Mesh {
            let id: Int
        }

        function first(mesh: borrow Mesh) -> borrow Mesh {
            return mesh
        }

        @Main
        function main() {
            let mesh = Mesh { id: 1 }
            first(mesh)
            return
        }
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM112")); return e }
}

// --- ownership_use_after_move (tests/fail/semantics/ownership_use_after_move)
FailTest FscOwnershipUseAfterMove {
    backends { hybrid vm llvm }
    source {
        struct Mesh {
            let id: Int
        }

        function consume(mesh: Mesh) -> Int {
            return mesh.id
        }

        function inspect(mesh: borrow Mesh) -> Int {
            return mesh.id
        }

        @Main
        function main() {
            var mesh = Mesh { id: 3 }
            print(consume(move mesh))
            print(inspect(mesh))
            return
        }
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM107")); return e }
}

// --- some_requires_construct (tests/fail/semantics/some_requires_construct)
FailTest FscSomeRequiresConstruct {
    backends { vm llvm hybrid }
    source {
        // `some` is existential over a construct family, so it requires a construct — the same rule as
        // `any` today, but the diagnostic must name the `some` keyword the author actually wrote.
        function acceptInt(value: some Int) {
            return;
        }
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM097")); return e }
}

// --- trailing_callback_not_accepted (tests/fail/semantics/trailing_callback_not_accepted)
FailTest FscTrailingCallbackNotAccepted {
    backends { hybrid vm }
    source {
        function draw(value: Int) {
            print(value)
            return
        }

        @Main
        function main() {
            draw(1) { value in
                print(value)
            }
            return
        }
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM081")); return e }
}

// --- trailing_callback_parameter_mismatch (tests/fail/semantics/trailing_callback_parameter_mismatch)
FailTest FscTrailingCallbackParameterMismatch {
    backends { hybrid vm }
    source {
        function register(handler: (Int) -> Void) {
            return;
        }

        @Main
        function main() {
            register { in
                return;
            }
            return;
        }
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM083")); return e }
}

// --- try_non_result (tests/fail/semantics/try_non_result)
FailTest FscTryNonResult {
    backends { hybrid vm }
    source {
        // `try` may only unwrap a `Result`-shaped value (an enum with `Ok` and `Error` variants).
        // Here it is applied to an integer.

        enum AppError {
            NotFound: String = "nf"
        }

        @Main
        function main() {
            attempt {
                let value = try 42
                print(value)
            } handle {
                NotFound {
                    print("nf")
                }
            }
            return
        }
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM134")); return e }
}

// --- try_outside_attempt (tests/fail/semantics/try_outside_attempt)
FailTest FscTryOutsideAttempt {
    backends { hybrid vm }
    source {
        // `try` is only valid inside an `attempt { ... }` block. Here it is used directly in a
        // function body.

        enum AppError {
            NotFound: String = "nf"
            Denied: String = "denied"
        }

        enum Outcome {
            Ok: Int
            Error: AppError
        }

        function load() -> Outcome {
            return .Ok(1)
        }

        @Main
        function main() {
            let value = try load()
            return
        }
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM133")); return e }
}

