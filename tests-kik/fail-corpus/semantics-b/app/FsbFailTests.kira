// --- macro_field_trigger_not_replace (tests/fail/semantics/macro_field_trigger_not_replace)
FailTest FsbMacroFieldTriggerNotReplace {
    backends { vm llvm hybrid }
    source {
// A `trigger { field }` macro must also be `replace { true }`: its whole purpose is rewriting
// the declaration that carries the triggering field, so append-alongside output would leave the
// unknown field annotation (`@Tracked`) in place for semantics to reject. KMAC029 pins this.

comptime macro Tracked {
    kind { attribute }
    appliesTo { form }
    trigger { field }

    expand(target: Declaration) -> Syntax {
        return quote { }
    }
}

construct Panel {
    @Required let body: Int
}

Panel Demo() {
    @Tracked var count: Int = 0
    let body: Int = 1
}

@Main
function main() {
    print("unreachable")
}
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KMAC029")); return e }
}

