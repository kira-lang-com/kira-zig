// --- macro_derive_not_a_macro (tests/fail/semantics/macro_derive_not_a_macro)
FailTest FsbMacroDeriveNotAMacro {
    backends { vm llvm hybrid }
    source {
// @Derive(X) where X is not a derive-kind macro must report KMAC011. A real derive macro is
// declared so `@Derive` is a recognized annotation form; `NotAMacro` names no macro at all.

comptime macro RealDerive {
    kind { derive }
    appliesTo { struct }
    expand(target: Declaration) -> Syntax {
        return quote {
            function realDeriveMarker() -> Bool {
                return true
            }
        }
    }
}

@Derive(NotAMacro)
struct Thing {
    var x: Int
}

@Main
function main() {
    return
}
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KMAC011")); return e }
}

// --- macro_drop_field_missing (tests/fail/semantics/macro_drop_field_missing)
FailTest FsbMacroDropFieldMissing {
    backends { vm llvm hybrid }
    source {
// `Syntax.dropField` on a field that does not exist is a macro-author error (KMAC025), never a
// silent no-op — a wrapper macro that thinks it dropped a field must not ship the original.

comptime macro Strip {
    kind { attribute }
    appliesTo { struct }
    replace { true }

    expand(target: Declaration) -> Syntax {
        return target.syntax.dropField("missing")
    }
}

@Strip
struct Holder {
    var present: Int = 0
}

@Main
function main() {
    print("unreachable")
}
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KMAC025")); return e }
}

