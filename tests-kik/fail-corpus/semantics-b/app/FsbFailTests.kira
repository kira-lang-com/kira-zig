// --- ownership_move_after_partial_move (tests/fail/semantics/ownership_move_after_partial_move)
FailTest FsbOwnershipMoveAfterPartialMove {
    backends { hybrid vm llvm }
    source {
struct Bag {
    var items: [Int]
}

function consume(bag: Bag) -> Int {
    return bag.items.count
}

function leak(bag: Bag) -> Int {
    let alias = bag.items
    return alias.count + consume(move bag)
}

@Main
function main() {
    let bag = Bag { items: [1, 2, 3] }
    print(leak(bag))
    return
}
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM107")); return e }
}

