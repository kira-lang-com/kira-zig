// --- macro_generated_diag_renders (tests/fail/semantics/macro_generated_diag_renders)
FailTest FsbMacroGeneratedDiagRenders {
    backends { vm llvm hybrid }
    source {
// A procedural macro's generated declarations are really analyzed: a semantic error inside
// generated code (here, a reference to an undefined name) must surface to the user with its real
// code (KSEM012) rather than being swallowed. (The CLI text-renderer crash on such synthetic-span
// diagnostics is guarded separately by a unit test in packages/kira_diagnostics/src/renderer.zig.)
comptime macro BadRef {
    kind { attribute }
    appliesTo { struct }
    expand(target: Declaration) -> Syntax {
        return quote {
            function generatedHelper() -> Int {
                return undefinedSymbolFromMacro
            }
        }
    }
}

@BadRef
struct PlainStruct {
    var value: Int
}

@Main
function main() {
    return
}
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM012")); return e }
}

// --- macro_property_wrapper_missing (tests/fail/semantics/macro_property_wrapper_missing)
FailTest FsbMacroPropertyWrapperMissing {
    backends { vm llvm hybrid }
    source {
comptime macro PropertyWrapper {
    kind { attribute }
    appliesTo { struct }
    expand(target: Declaration) -> Syntax {
        var hasWrapped: Bool = false
        for field in target.fields {
            if field.name.asString() == "wrappedValue" {
                hasWrapped = true
            }
        }
        if hasWrapped == false {
            Diagnostics.error("PropertyWrapper requires a wrappedValue field", at: target.syntax)
            return quote { }
        }
        return quote {
            function ok() -> Bool {
                return true
            }
        }
    }
}

@PropertyWrapper
struct NotAWrapper {
    var value: Int
}

@Main
function main() {
    return
}
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KMAC021")); return e }
}

