// --- illegal_construct_annotation (tests/fail/semantics/illegal_construct_annotation)
FailTest FsbIllegalConstructAnnotation {
    backends { hybrid vm }
    source {
annotation State {
}

annotation Binding {
}

construct Widget {
    annotations {
        @State;
    }

    lifecycle {
        onAppear() {}
    }
}

Widget Card() {
    @Binding
    let selected: Int = 0;

    content {
        Text("Card")
    }
}
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM026")); return e }
}

