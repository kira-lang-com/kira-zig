// FgrFailTests.kira — migrated import-graph compile-failure corpus (tests/fail/graph).
//
// Imports are file-scoped: this file uses Foundation's Result / TestFailure, so it
// imports Foundation itself rather than relying on app/main.kira's import.
//
// MANIFEST (case -> FailTest name -> expected Compile code):
//   outside_app_import          -> FgrOutsideAppImport          (fixture) KSEM032
//   file_scoped_bare_import     -> FgrFileScopedBareImport      (fixture) KSEM012
//   file_scoped_qualified_import-> FgrFileScopedQualifiedImport (fixture) KSEM027
//   file_scoped_type_import     -> FgrFileScopedTypeImport      (fixture) KSEM078

import Foundation

// --- outside_app_import (tests/fail/graph/outside_app_import)
// Import-graph case: app/main.kira does `import support as Support`, but the
// `support.kira` module lives OUTSIDE the app/ module root, so the import cannot
// resolve (KSEM032). The failure is a property of the on-disk directory layout
// spanning two files, so it needs a fixture DIRECTORY — no single-file source
// (block or raw-string) can express a module physically outside the package.
FailTest FgrOutsideAppImport {
    backends { hybrid vm }
    source {
        fixture("fixtures/outside_app_import")
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM032")); return e }
}

// --- file_scoped_bare_import (imports are per-file)
// app/main.kira imports Foundation, but the sibling app/leak.kira does not. A BARE
// reference to Foundation's `printLine` in the sibling must not resolve through the
// other file's import, so it is rejected as an unknown name (KSEM012) with a hint to
// add `import Foundation`. Needs a fixture DIRECTORY: the leak is cross-file.
FailTest FgrFileScopedBareImport {
    backends { hybrid vm }
    source {
        fixture("fixtures/file_scoped_bare_import")
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM012")); return e }
}

// --- file_scoped_qualified_import (imports are per-file)
// Same layout, but the sibling uses the QUALIFIED `Foundation.printLine`. Because the
// sibling never imports Foundation, the `Foundation` namespace root is unresolved in
// this file (KSEM027) — a sibling's import does not bring the namespace into scope.
FailTest FgrFileScopedQualifiedImport {
    backends { hybrid vm }
    source {
        fixture("fixtures/file_scoped_qualified_import")
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM027")); return e }
}

// --- file_scoped_type_import (imports are per-file, types included)
// Same layout, but the sibling constructs Foundation's `TestResult` STRUCT TYPE
// bare. Type and construct names are file-scoped exactly like functions and
// enums, so the construction is rejected (KSEM078) with an import hint.
FailTest FgrFileScopedTypeImport {
    backends { hybrid vm }
    source {
        fixture("fixtures/file_scoped_type_import")
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM078")); return e }
}

// --- construct_default_dep_import (imports are per-file; construct defaults)
// A form (`Gadget Badge { ... }`) of a DEPENDENCY construct inherits the
// construct's default members. Those defaults were written in dep_widgets'
// file, which imports DepGeo; lowering them for the form must gate their
// signature/body types against the DECLARING file's imports, not the form
// file's (which never names DepGeo). Regression: this misfired as KSEM168
// pointing at the dependency file.
FailTest FgrConstructDefaultDepImport {
    backends { hybrid vm }
    source {
        fixture("fixtures/construct_default_dep_import")
    }
    expect { let e: Result<Int, TestFailure> = .Ok(0); return e }
}

// --- enum_anchored_transitive (expected-type anchored enum constructors)
// GeoMode lives in DepGeo, a TRANSITIVE dependency of the fixture app. Both
// anchored constructor spellings — `.Fixed(w)` and `DepWidgets.GeoMode.Fixed(w)`
// (qualified via the re-exposing direct dependency) — must resolve through the
// anchoring field type. Regression: the import gate blocked the enum lookup and
// the constructions fell through to KSEM167/KSEM092.
FailTest FgrEnumAnchoredTransitiveDep {
    backends { hybrid vm }
    source {
        fixture("fixtures/enum_anchored_transitive")
    }
    expect { let e: Result<Int, TestFailure> = .Ok(0); return e }
}

// --- enum_unanchored_missing_import (strict when nothing anchors the enum)
// With NO expected type anchoring the construction, the file names GeoMode
// directly and must import DepGeo itself; the rejection carries the add-import
// hint rather than a misleading not-callable error.
FailTest FgrEnumUnanchoredMissingImport {
    backends { hybrid vm }
    source {
        fixture("fixtures/enum_unanchored_missing_import")
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM012")); return e }
}
