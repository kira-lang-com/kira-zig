// FsaFailTests.kira — migrated legacy expected-diagnostic corpus (semantics slice A).
//
// Each FailTest wraps a legacy tests/fail/semantics/<case>/main.kira source verbatim
// and asserts the compile-failure diagnostic code recorded in that case's expect.toml.
//
// Manifest (legacy case -> FailTest name -> diagnostic code):
//   ambiguous_inference                              -> FsaAmbiguousInference                            (KSEM029)
//   ambiguous_inherited_field_lookup                 -> FsaAmbiguousInheritedFieldLookup                 (KSEM057)
//   ambiguous_inherited_method_lookup                -> FsaAmbiguousInheritedMethodLookup                (KSEM056)
//   annotation_parameter_type_mismatch               -> FsaAnnotationParameterTypeMismatch               (KSEM071)
//   any_requires_construct_class                     -> FsaAnyRequiresConstructClass                     (KSEM097)
//   any_requires_construct_primitive                 -> FsaAnyRequiresConstructPrimitive                 (KSEM097)
//   attempt_incompatible_failures                    -> FsaAttemptIncompatibleFailures                   (KSEM137)
//   attempt_missing_handler                          -> FsaAttemptMissingHandler                         (KSEM135)
//   attempt_unknown_handler                          -> FsaAttemptUnknownHandler                         (KSEM136)
//   break_outside_loop                               -> FsaBreakOutsideLoop                              (KSEM075)
//   conflicting_execution                            -> FsaConflictingExecution                          (KSEM005)
//   construct_array_field_alias                      -> FsaConstructArrayFieldAlias                      (KSEM118)
//   construct_channel_accepts                        -> FsaConstructChannelAccepts                       (KSEM130)
//   construct_channel_count                          -> FsaConstructChannelCount                         (KSEM129)
//   construct_channel_duplicate                      -> FsaConstructChannelDuplicate                     (KSEM138)
//   construct_channel_unknown                        -> FsaConstructChannelUnknown                       (KSEM127)
//   construct_content_sealed                         -> FsaConstructContentSealed                        (KSEM128)
//   construct_form_cycle                             -> FsaConstructFormCycle                            (KSEM119)
//   construct_inheritance_cycle                      -> FsaConstructInheritanceCycle                     (KSEM119)
//   construct_projection_unknown                     -> FsaConstructProjectionUnknown                    (KSEM131)
//   construct_property_duplicate                     -> FsaConstructPropertyDuplicate                    (KSEM126)
//   construct_property_missing_required              -> FsaConstructPropertyMissingRequired              (KSEM123)
//   construct_property_type_mismatch                 -> FsaConstructPropertyTypeMismatch                 (KSEM125)
//   construct_property_unknown                       -> FsaConstructPropertyUnknown                      (KSEM124)
//   construct_refine_widen                           -> FsaConstructRefineWiden                          (KSEM132)
//   construct_required_missing                       -> FsaConstructRequiredMissing                      (KSEM120)
//   construct_required_signature                     -> FsaConstructRequiredSignature                    (KSEM121)
//   construct_unknown_parent                         -> FsaConstructUnknownParent                        (KSEM118)
//   content_string_not_widget                        -> FsaContentStringNotWidget                        (KSEM098)
//   continue_outside_loop                            -> FsaContinueOutsideLoop                           (KSEM076)
//   direct_ffi_requires_native                       -> FsaDirectFfiRequiresNative                       (KSEM093)
//   duplicate_main_annotation                        -> FsaDuplicateMainAnnotation                       (KSEM004)
//   duplicate_parent_type                            -> FsaDuplicateParentType                           (KSEM051)
//   duplicate_struct_literal_field                   -> FsaDuplicateStructLiteralField                   (KSEM080)
//   enum_incomplete_match                            -> FsaEnumIncompleteMatch                           (KSEM100)
//   expr_chain_too_deep                              -> FsaExprChainTooDeep                              (KSEM155)
//   extra_annotation_parameter                       -> FsaExtraAnnotationParameter                      (KSEM064)
//   ffi_struct_typed_declaration_stays_uninitialized -> FsaFfiStructTypedDeclarationStaysUninitialized   (KSEM086)
//   field_access_requires_structured_type            -> FsaFieldAccessRequiresStructuredType             (KSEM047)
//   illegal_coercion                                 -> FsaIllegalCoercion                               (KSEM031)
