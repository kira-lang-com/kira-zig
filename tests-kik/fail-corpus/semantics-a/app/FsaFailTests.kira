// Count: 40 FailTest declarations.

// --- ambiguous_inference (tests/fail/semantics/ambiguous_inference)
FailTest FsaAmbiguousInference {
    backends { vm hybrid }
    source {
@Main
function entry() {
    let value;
    return;
}
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM029")); return e }
}

