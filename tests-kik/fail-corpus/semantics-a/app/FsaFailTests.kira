    content {
        body {
            accepts Title
            count 0..
        }
    }
}

WebElement Page {
    body {
        "not an element"
    }
}

@Main
function main() {
    return
}
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM165")); return e }
}

