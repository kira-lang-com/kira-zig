// --- extra_annotation_parameter (tests/fail/semantics/extra_annotation_parameter)
FailTest FsaExtraAnnotationParameter {
    backends { vm hybrid }
    source {
annotation State {
}

construct Widget {
    annotations {
        @State;
    }
}

Widget Button() {
    @State(1)
    let isPressed: Bool = false;

    content {
    }
}

@Main
function entry() {
    return;
}
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM064")); return e }
}

// --- ffi_struct_typed_declaration_stays_uninitialized (tests/fail/semantics/ffi_struct_typed_declaration_stays_uninitialized)
FailTest FsaFfiStructTypedDeclarationStaysUninitialized {
    backends { vm hybrid }
    source {
@FFI.Struct { layout: c; }
struct Example {
    var a: U8
}

@Main
function entry() {
    var value: Example
    print(value.a)
    return
}
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM086")); return e }
}

// --- field_access_requires_structured_type (tests/fail/semantics/field_access_requires_structured_type)
FailTest FsaFieldAccessRequiresStructuredType {
    backends { vm hybrid }
    source {
@Main
function entry() {
    let value = 1
    print(value.x)
    return
}
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM047")); return e }
}

// --- illegal_coercion (tests/fail/semantics/illegal_coercion)
FailTest FsaIllegalCoercion {
    backends { vm hybrid }
    source {
@Main
function entry() {
    let value: String = 12;
    print(value);
    return;
}
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM031")); return e }
}
