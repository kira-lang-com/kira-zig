// --- attempt_incompatible_failures (tests/fail/semantics/attempt_incompatible_failures)
FailTest FsaAttemptIncompatibleFailures {
    backends { vm hybrid }
    source {
// All `try` expressions in one `attempt` must share a single failure enum. Here the two
// `try` expressions produce different failure types (`AppError` and `NetError`).

enum AppError {
    NotFound: String = "nf"
}

enum NetError {
    Timeout: String = "to"
}

enum AppOutcome {
    Ok: Int
    Error: AppError
}

enum NetOutcome {
    Ok: Int
    Error: NetError
}

function loadApp() -> AppOutcome {
    return .Ok(1)
}

function loadNet() -> NetOutcome {
    return .Ok(2)
}

@Main
function main() {
    attempt {
        let a = try loadApp()
        let b = try loadNet()
        print(a)
    } handle {
        NotFound {
            print("nf")
        }
    }
    return
}
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM137")); return e }
}

// --- attempt_missing_handler (tests/fail/semantics/attempt_missing_handler)
FailTest FsaAttemptMissingHandler {
    backends { vm hybrid }
    source {
// Every reachable failure variant must be handled. `AppError` has `NotFound` and `Denied`,
// but the `attempt` only handles `NotFound`.

enum AppError {
    NotFound: String = "nf"
    Denied: String = "denied"
}

enum Outcome {
    Ok: Int
    Error: AppError
}

function load() -> Outcome {
    return .Error(.Denied("no"))
}

@Main
function main() {
    attempt {
        let value = try load()
        print(value)
    } handle {
        NotFound {
            print("nf")
        }
    }
    return
}
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM135")); return e }
}

// --- attempt_unknown_handler (tests/fail/semantics/attempt_unknown_handler)
FailTest FsaAttemptUnknownHandler {
    backends { vm hybrid }
    source {
// A handle case must name a variant of the failure enum. `Bogus` is not a variant of
// `AppError`.

enum AppError {
    NotFound: String = "nf"
    Denied: String = "denied"
}

enum Outcome {
    Ok: Int
    Error: AppError
}

function load() -> Outcome {
    return .Ok(1)
}

@Main
function main() {
    attempt {
        let value = try load()
        print(value)
    } handle {
        NotFound {
            print("nf")
        }
        Denied {
            print("denied")
        }
        Bogus {
            print("bogus")
        }
    }
    return
}
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM136")); return e }
}

