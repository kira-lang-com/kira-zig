// --- construct_array_field_alias (tests/fail/semantics/construct_array_field_alias)
FailTest FsaConstructArrayFieldAlias {
    backends { vm llvm hybrid }
    source {
// An array-typed struct field initialized from an existing array value (here the
// `bag.items` field of an owned parameter) would share the source's backing store.
// Kira has no deep copy for arrays and the backend cannot transfer ownership of an
// array *field*, so the new struct's `items` would dangle once `bag` is dropped at
// function exit — the latent use-after-free behind the widget-lowering crash
// `enum native copy could not resolve discriminant`. This must be rejected at `check`.
struct Item {
    let v: Int
}

struct Bag {
    var items: [Item]
}

function rebuild(bag: Bag) -> Bag {
    return Bag { items: bag.items }
}

@Main
function main() {
    let bag = Bag { items: [Item { v: 1 }] }
    let next = rebuild(bag)
    print(next.items.count)
    return
}
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM118")); return e }
}

// --- Construct 2.0 item 4: slot-by-type fields are never filled via parens (KSEM162)
FailTest FsaConstructSlotViaParens {
    backends { vm llvm hybrid }
    source {
// A construct-form field typed `[some X]` (or `some X`) is a caller-provided child slot: it is
// filled by the trailing content block, never by a constructor parenthesized argument. Passing
// the slot by name in parens is rejected at `check` (KSEM162).
construct SlotWidget {
    @Required let body: SlotWidget

    function render() -> [String] {
        return body.render()
    }
}

SlotWidget SlotLeaf(text: String) {
    function render() -> [String] {
        return [text]
    }
}

SlotWidget SlotRow() {
    let children: [some SlotWidget]

    function render() -> [String] {
        return children[0].render()
    }
}

@Main
function main() {
    let row = SlotRow(children = [SlotLeaf(text: "a")])
    return
}
    }
    expect { let e: Result<Int, TestFailure> = .Error(.Compile("KSEM162")); return e }
}

// --- construct_channel_accepts (tests/fail/semantics/construct_channel_accepts)
FailTest FsaConstructChannelAccepts {
    backends { vm hybrid }
    source {
// The `body` channel accepts `Title` elements. A raw string literal is never an element, so
// placing one in the channel is rejected.

