// --- expr_chain_too_deep (tests/fail/semantics/expr_chain_too_deep)
FailTest FsaExprChainTooDeep {
    backends { vm hybrid }
    source {
// Regression (FE2): a long FLAT operator chain (parsed iteratively, so it
// escapes the parser's nesting guard FE1/KPAR014) builds an AST whose left
// spine is ~700 deep. The recursive semantic walkers (enum registration and
// type lowering) descended it and overflowed the native stack (SIGABRT, no
// diagnostic). They now bound their recursion depth and emit a clean located
// KSEM155 instead.
@Main
function main() {
