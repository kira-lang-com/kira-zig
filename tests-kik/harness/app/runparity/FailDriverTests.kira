// Each Test drives the in-process compiler on one fixture package and asserts
// the outcome. `Foundation.checkPackage(path, backend)` returns a
// `DeveloperCommandReport { success, text, error }`; we reduce it to a scalar.
//
// Prefix: fh / Fh. This file must NOT `import Foundation` (main.kira already
// does; a second import is a duplicate top-level name).

// Returns 1 if the package at `path` is REJECTED by the compiler, else 0.
function fhRejected(path: borrow String) -> Int {
    let report = Foundation.checkPackage(path, Backend.Vm)
    if report.success { return 0 }
    return 1
}

// Returns 1 if the package at `path` is ACCEPTED by the compiler, else 0.
function fhAccepted(path: borrow String) -> Int {
    let report = Foundation.checkPackage(path, Backend.Vm)
    if report.success { return 1 }
    return 0
}

// Returns 1 if a rejected package produced a non-empty diagnostic report.
function fhRejectedWithText(path: borrow String) -> Int {
    let report = Foundation.checkPackage(path, Backend.Vm)
    if report.success { return 0 }
    if report.text.count > 0 { return 1 }
    return 0
}

Test FhRejectsUnknownName {
    test { return fhRejected("tests-kik/harness/fixtures/reject_unknown_name") }
    expect { let e: Result<Int, TestFailure> = Result.Ok(1); return e }
}

Test FhRejectsArgTypeMismatch {
    test { return fhRejected("tests-kik/harness/fixtures/reject_arg_type") }
    expect { let e: Result<Int, TestFailure> = Result.Ok(1); return e }
}

Test FhAcceptsTrivial {
    test { return fhAccepted("tests-kik/harness/fixtures/accept_trivial") }
    expect { let e: Result<Int, TestFailure> = Result.Ok(1); return e }
}

Test FhRejectionCarriesDiagnostic {
    test { return fhRejectedWithText("tests-kik/harness/fixtures/reject_unknown_name") }
    expect { let e: Result<Int, TestFailure> = Result.Ok(1); return e }
}
