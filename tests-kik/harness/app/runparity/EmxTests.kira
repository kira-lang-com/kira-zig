// EmxTests.kira — corpus migration of tests/pass/run/{enum_basic_parity,
// enum_equality_tag_compare, enum_kind_split_cache_parity,
// enum_payload_move_chain_parity, enum_result_parity,
// enum_var_reassign_return, nested_enum_payload_parity,
// copyable_payload_enum_field_reuse, fieldless_enum_is_copy,
// attempt_handle_payloadless_variant, attempt_try_handle} into the
// `kira test` Test-construct format. All top-level names use prefix
// emx / Emx.

// ---------------------------------------------------------------------------
// enum_basic_parity
// ---------------------------------------------------------------------------

enum EmxParseError {
    InvalidFormat: String = "Not the expected format"
    UnexpectedEnd
    EmptyInput
}

Test EmxParseErrorInvalidText {
    test {
        let invalid = EmxParseError.InvalidFormat
        var out = ""
        match invalid {
            InvalidFormat(text) -> { out = text }
            UnexpectedEnd -> { out = "unexpected" }
            EmptyInput -> { out = "empty" }
        }
        return out
    }
    expect { let e: Result<String, TestFailure> = Result.Ok("Not the expected format"); return e }
}

Test EmxParseErrorEndedBranch {
    test {
        let ended = EmxParseError.UnexpectedEnd
        var out = ""
        match ended {
            InvalidFormat(text) -> { out = text }
            UnexpectedEnd -> { out = "end" }
            EmptyInput -> { out = "empty" }
        }
        return out
    }
    expect { let e: Result<String, TestFailure> = Result.Ok("end"); return e }
}

Test EmxParseErrorEmptyBranch {
    test {
        let empty = EmxParseError.EmptyInput
        var out = ""
        match empty {
            InvalidFormat(text) -> { out = text }
            UnexpectedEnd -> { out = "end" }
            EmptyInput -> { out = "empty" }
        }
        return out
    }
    expect { let e: Result<String, TestFailure> = Result.Ok("empty"); return e }
}

// ---------------------------------------------------------------------------
// enum_equality_tag_compare
// ---------------------------------------------------------------------------

enum EmxColor { Red Green Blue }

struct EmxBox { let c: EmxColor }

function emxRank(c: EmxColor) -> Int {
    if c == EmxColor.Red { return 1 }
    if c == EmxColor.Green { return 2 }
    return 3
}

function emxIsBlue(b: borrow EmxBox) -> Bool {
    return b.c == EmxColor.Blue
}

Test EmxEqualityTagCompareTotal {
    test {
        var total = emxRank(EmxColor.Red) + emxRank(EmxColor.Green) + emxRank(EmxColor.Blue)
        let red = EmxColor.Red
        let green = EmxColor.Green
        if red != green { total = total + 10 }
        let blueBox = EmxBox { c: EmxColor.Blue }
        let blueResult = emxIsBlue(blueBox)
        if blueResult == true { total = total + 100 }
        return total
    }
    expect { let e: Result<Int, TestFailure> = Result.Ok(116); return e }
}

// ---------------------------------------------------------------------------
// enum_kind_split_cache_parity
// ---------------------------------------------------------------------------

construct EmxShape {
    @Required let area: Int
}

EmxShape EmxCircle {
    let r: Int = 1
    let area: Int {
        r
    }
}

EmxShape EmxSquare {
    let s: Int = 1
    let area: Int {
        s
    }
}

enum EmxCell {
    Filled(some EmxShape)
    Empty
}

struct EmxGrid {
    var cells: [EmxCell]
}

function emxAreaOf(c: borrow EmxCell) -> Int {
    match c {
        Filled(shape) -> return shape.area;
        Empty -> return 0;
    }
}

function emxTotalArea(grid: borrow EmxGrid) -> Int {
    var sum = 0
    var index = 0
    while index < grid.cells.count {
        sum = sum + emxAreaOf(grid.cells[index])
        index = index + 1
    }
    return sum
}

Test EmxEnumKindSplitCacheParity {
    test {
        let cells = [EmxCell.Filled(EmxCircle(r: 3)), EmxCell.Empty, EmxCell.Filled(EmxSquare(s: 4))]
        let grid = EmxGrid { cells: move cells }
        var out = grid.cells.count
        out = out * 100 + emxTotalArea(grid)
        return out
    }
    // count=3, totalArea=7 -> 3*100+7=307
    expect { let e: Result<Int, TestFailure> = Result.Ok(307); return e }
}

// ---------------------------------------------------------------------------
// enum_payload_move_chain_parity
// ---------------------------------------------------------------------------

enum EmxInner {
    A: String = "a"
    B: String = "b"
}

enum EmxWrap {
    One(EmxInner)
    Two(EmxInner)
}

function emxRewrap(w: EmxWrap) -> EmxWrap {
    match w {
        One(failure) -> { return EmxWrap.Two(move failure) }
        Two(failure) -> { return EmxWrap.One(move failure) }
    }
}

Test EmxPayloadMoveChainParity {
    test {
        let original = EmxWrap.One(EmxInner.A("payload"))
        let swapped = emxRewrap(move original)
        var out = ""
        match swapped {
            One(failure) -> {
                match failure {
                    A(reason) -> { out = reason }
                    B(reason) -> { out = reason }
                }
            }
            Two(failure) -> {
                match failure {
                    A(reason) -> { out = reason }
                    B(reason) -> { out = reason }
                }
            }
        }
        return out
    }
    expect { let e: Result<String, TestFailure> = Result.Ok("payload"); return e }
}

// ---------------------------------------------------------------------------
// enum_result_parity
// ---------------------------------------------------------------------------

enum EmxResultParseError {
    InvalidFormat: String = "bad"
    UnexpectedEnd
}

Test EmxResultParitySuccess {
    test {
        let success: Result<String, EmxResultParseError> = Result.Ok("ok")
        var out = ""
        match success {
            Ok(text) -> { out = text }
            Error(err) -> { out = "err" }
        }
        return out
    }
    expect { let e: Result<String, TestFailure> = Result.Ok("ok"); return e }
}

Test EmxResultParityFailureText {
    test {
        let failure: Result<String, EmxResultParseError> = Result.Error(EmxResultParseError.InvalidFormat)
        var out = ""
        match failure {
            Ok(text) -> { out = text }
            Error(err) -> {
                match err {
                    InvalidFormat(t) -> { out = t }
                    UnexpectedEnd -> { out = "end" }
                }
            }
        }
        return out
    }
    expect { let e: Result<String, TestFailure> = Result.Ok("bad"); return e }
}

// ---------------------------------------------------------------------------
// enum_var_reassign_return
// ---------------------------------------------------------------------------

enum EmxShade { Light Dark Mid }

function emxShadeWeight(s: borrow EmxShade) -> Int {
    match s {
        Light -> { return 1 }
        Dark -> { return 2 }
        Mid -> { return 3 }
    }
}

function emxShadeFor(i: Int) -> EmxShade {
    var s = EmxShade.Light
    switch i % 3 {
        case 0 { s = EmxShade.Light }
        case 1 { s = EmxShade.Dark }
        case 2 { s = EmxShade.Mid }
        default { s = EmxShade.Light }
    }
    return s
}

enum EmxValBox { Empty  Val(Int) }

function emxBoxVal(b: borrow EmxValBox) -> Int {
    match b {
        Empty -> { return 0 }
        Val(v) -> { return v }
    }
}

function emxPick(i: Int) -> EmxValBox {
    var b = EmxValBox.Empty
    if i % 2 == 0 { b = EmxValBox.Val(i * 10) }
    if i % 3 == 0 { b = EmxValBox.Val(i * 100) }
    return b
}

Test EmxVarReassignReturn {
    test {
        var acc = 0
        var i = 0
        while i < 60 {
            acc = acc + emxShadeWeight(emxShadeFor(i))
            i = i + 1
        }
        var j = 0
        while j < 20 {
            acc = acc + emxBoxVal(emxPick(j))
            j = j + 1
        }
        return acc
    }
    expect { let e: Result<Int, TestFailure> = Result.Ok(6960); return e }
}

// ---------------------------------------------------------------------------
// nested_enum_payload_parity (also reused by attempt_try_handle below)
// ---------------------------------------------------------------------------

enum EmxRenderFailure {
    MissingNode: String = "missing"
    InvalidState: String = "invalid"
}

function emxFailWith(useMissing: Bool) -> Result<Int, EmxRenderFailure> {
    if useMissing {
        return Result.Error(EmxRenderFailure.MissingNode("boom"))
    }
    return Result.Error(EmxRenderFailure.InvalidState("halt"))
}

function emxReportReason(r: Result<Int, EmxRenderFailure>) -> String {
    var out = ""
    match r {
        Ok(value) -> { out = "ok" }
        Error(failure) -> {
            match failure {
                MissingNode(reason) -> { out = reason }
                InvalidState(reason) -> { out = reason }
            }
        }
    }
    return out
}

Test EmxNestedEnumPayloadParityMissing {
    test { return emxReportReason(emxFailWith(true)) }
    expect { let e: Result<String, TestFailure> = Result.Ok("boom"); return e }
}

Test EmxNestedEnumPayloadParityInvalid {
    test { return emxReportReason(emxFailWith(false)) }
    expect { let e: Result<String, TestFailure> = Result.Ok("halt"); return e }
}

// ---------------------------------------------------------------------------
// copyable_payload_enum_field_reuse
// ---------------------------------------------------------------------------

enum EmxDimension {
    Fixed(Float)
    Fill
    Bounded(Float)
}

struct EmxSizeBox {
    let width: EmxDimension
    let height: EmxDimension
}

function emxConsume(d: EmxDimension) -> Int {
    match d {
        Fill -> return 1;
        Fixed(_) -> return 0;
        Bounded(_) -> return 0;
    }
}

function emxCheck(box: EmxSizeBox) -> Int {
    let a = emxConsume(box.width)
    let b = emxConsume(box.width)
    return a + b
}

Test EmxCopyablePayloadEnumFieldReuse {
    test {
        let box = EmxSizeBox { width: EmxDimension.Fill, height: EmxDimension.Fixed(3.0) }
        return emxCheck(move box)
    }
    expect { let e: Result<Int, TestFailure> = Result.Ok(2); return e }
}

// ---------------------------------------------------------------------------
// fieldless_enum_is_copy
// ---------------------------------------------------------------------------

enum EmxAxis {
    Horizontal
    Vertical
}

function emxCode(axis: EmxAxis) -> Int {
    if axis == EmxAxis.Horizontal {
        return 1
    }
    return 2
}

struct EmxDescriptor {
    let axis: EmxAxis
    let weight: Int
}

function emxScore(descriptor: EmxDescriptor) -> Int {
    let first = emxCode(descriptor.axis)
    let second = emxCode(descriptor.axis)
    return first + second + descriptor.weight
}

Test EmxFieldlessEnumIsCopy {
    test {
        let descriptor = EmxDescriptor {
            axis: EmxAxis.Vertical
            weight: 5
        }
        return emxScore(move descriptor)
    }
    expect { let e: Result<Int, TestFailure> = Result.Ok(9); return e }
}

// ---------------------------------------------------------------------------
// attempt_handle_payloadless_variant
// ---------------------------------------------------------------------------

enum EmxClampError {
    TooSmall
    TooBig
}

function emxClamp(n: Int) -> Result<Int, EmxClampError> {
    if n < 0 {
        return Result.Error(EmxClampError.TooSmall)
    }
    if n > 100 {
        return Result.Error(EmxClampError.TooBig)
    }
    return Result.Ok(n)
}

function emxProcess(n: Int) -> Int {
    attempt {
        let v = try emxClamp(n)
        return v * 2
    } handle {
        TooSmall { return 0 - 1 }
        TooBig { return 0 - 2 }
    }
}

function emxBump(x: Int) -> Int {
    let f: (Int) -> Int = { v in return v + 1 }
    return f(x)
}

Test EmxAttemptHandlePayloadlessVariantOk {
    test { return emxProcess(50) }
    expect { let e: Result<Int, TestFailure> = Result.Ok(100); return e }
}

Test EmxAttemptHandlePayloadlessVariantTooSmall {
    test { return emxProcess(0 - 5) }
    expect { let e: Result<Int, TestFailure> = Result.Ok(0 - 1); return e }
}

Test EmxAttemptHandlePayloadlessVariantTooBig {
    test { return emxProcess(200) }
    expect { let e: Result<Int, TestFailure> = Result.Ok(0 - 2); return e }
}

Test EmxAttemptHandlePayloadlessVariantBump {
    test { return emxBump(41) }
    expect { let e: Result<Int, TestFailure> = Result.Ok(42); return e }
}

// ---------------------------------------------------------------------------
// attempt_try_handle
// ---------------------------------------------------------------------------

function emxRenderOk() -> Result<Int, EmxRenderFailure> {
    return Result.Ok(42)
}

function emxRenderFail() -> Result<Int, EmxRenderFailure> {
    return Result.Error(EmxRenderFailure.MissingNode("boom"))
}

function emxAttemptTryHandleOk() -> Int {
    attempt {
        let value = try emxRenderOk()
        return value
    } handle {
        MissingNode(reason) { return 0 - 1 }
        InvalidState(reason) { return 0 - 2 }
    }
}

function emxAttemptTryHandleFailReason() -> String {
    attempt {
        let value = try emxRenderFail()
        return "ok"
    } handle {
        MissingNode(reason) { return reason }
        InvalidState(reason) { return reason }
    }
}

Test EmxAttemptTryHandleOk {
    test { return emxAttemptTryHandleOk() }
    expect { let e: Result<Int, TestFailure> = Result.Ok(42); return e }
}

Test EmxAttemptTryHandleFail {
    test { return emxAttemptTryHandleFailReason() }
    expect { let e: Result<String, TestFailure> = Result.Ok("boom"); return e }
}

// ---------------------------------------------------------------------------
// Native drop-elaboration leak guards (2026-07-10). Each exercise churns the
// pattern in a loop so a per-element/per-iteration native leak scales and is
// caught by the harness leak run (KIRA_RUNTIME_MEMORY_REPORT=1 / leaks
// --atExit on the llvm binary) while the returned checksum pins parity.
// ---------------------------------------------------------------------------

// Array-of-enum element teardown (Destructors.elementDestroy enum branch): an
// enum stored as a RAW_PTR-tagged array element must tear down through the
// typed kira_destroy_enum_<T> — previously it fell through to the tag-safe
// closure no-op and leaked the 16-byte enum block AND its String payload box +
// buffer on every array release.
enum EmxTag {
    Named(String)
    Anon
}

struct EmxBag {
    var tags: [EmxTag]
}

function emxScoreTag(tag: borrow EmxTag) -> Int {
    match tag {
        Named(name) -> {
            if name == "ab" {
                return 1
            }
            return 2
        }
        Anon -> return 0
    }
    return 0
}

function emxCountNamed(bag: borrow EmxBag) -> Int {
    var n = 0
    var i = 0
    while i < bag.tags.count {
        n = n + emxScoreTag(bag.tags[i])
        i = i + 1
    }
    return n
}

Test EmxArrayEnumStringPayloadFree {
    test {
        var total = 0
        var i = 0
        while i < 500 {
            let tags = [EmxTag.Named("a" + "b"), EmxTag.Anon, EmxTag.Named("c" + "d")]
            let bag = EmxBag { tags: move tags }
            total = total + emxCountNamed(bag)
            i = i + 1
        }
        return total
    }
    // 500 * (1 + 0 + 2) = 1500
    expect { let e: Result<Int, TestFailure> = Result.Ok(1500); return e }
}

// Struct-payload enum teardown (kira_destroy_enum_<T> ffi_struct arm): an enum
// variant carrying a struct payload owns the shell + contents; destroy frees it
// via kira_destroy_<T> and clone deep-copies via kira_clone_<T>. Previously the
// payload shell leaked (the field_override_enum_payload_defaults 2-leak class:
// class-field default arrays of struct-payload enums).
struct EmxColorVal {
    let r: Int = 1
}

struct EmxGlowPayload {
    let color: EmxColorVal = EmxColorVal {}
    let radius: Int = 4
}

enum EmxPaint {
    Flat
    Glow(EmxGlowPayload)
}

class EmxSurface {
    let paint: EmxPaint = EmxPaint.Flat
    let effects: [EmxPaint] = []
}

class EmxCard extends EmxSurface {
    override let paint: EmxPaint = EmxPaint.Flat
    override let effects: [EmxPaint] = [EmxPaint.Glow(EmxGlowPayload { color: EmxColorVal { r: 5 } })]
}

function emxPaintScore(p: borrow EmxPaint) -> Int {
    match p {
        Flat -> return 1;
        Glow(payload) -> return payload.color.r * 10 + payload.radius;
    }
    return 0
}

Test EmxStructPayloadEnumDefaultsFree {
    test {
        var total = 0
        var i = 0
        while i < 200 {
            let card = EmxCard()
            total = total + emxPaintScore(card.paint)
            var j = 0
            while j < card.effects.count {
                total = total + emxPaintScore(card.effects[j])
                j = j + 1
            }
            i = i + 1
        }
        return total
    }
    // per iteration: Flat=1, Glow(r:5, radius:4)=54 -> 55; 200 * 55 = 11000
    expect { let e: Result<Int, TestFailure> = Result.Ok(11000); return e }
}

// Construct_any-payload enum teardown churn (kira_capi_dynamic_destroy arm +
// KIR002 move-only guarantee): loops the enum_kind_split_cache_parity shape so
// a per-iteration shell leak scales. The clone arm for the Filled variant is
// unreachable-by-checker (contains-any enums are move-only) and traps.
Test EmxConstructAnyPayloadEnumChurn {
    test {
        var total = 0
        var i = 0
        while i < 200 {
            let cells = [EmxCell.Filled(EmxCircle(r: 3)), EmxCell.Empty, EmxCell.Filled(EmxSquare(s: 4))]
            let grid = EmxGrid { cells: move cells }
            total = total + grid.cells.count + emxTotalArea(grid)
            i = i + 1
        }
        return total
    }
    // per iteration: count=3 + area=7 -> 10; 200 * 10 = 2000
    expect { let e: Result<Int, TestFailure> = Result.Ok(2000); return e }
}

// Array-payload enum teardown (kira_destroy_enum_<T> .array arm): a variant
// carrying an owned array (Result<[Int], E>.Ok shape) moves the KiraArray* in;
// destroy releases it with the typed element destructor, clone deep-copies it.
// Previously the whole array (box + storage) leaked per constructed value (the
// kik-harness genRange 22-leak class).
enum EmxRangeResult {
    Ok([Int])
    Fail(Int)
}

function emxMakeRange(n: Int) -> EmxRangeResult {
    if n <= 0 {
        return EmxRangeResult.Fail(0 - 1)
    }
    var xs: [Int] = []
    var i = 0
    while i < n {
        xs.append(i * 2)
        i = i + 1
    }
    return EmxRangeResult.Ok(move xs)
}

function emxSumRange(r: borrow EmxRangeResult) -> Int {
    match r {
        Ok(xs) -> {
            var total = 0
            var i = 0
            while i < xs.count {
                total = total + xs[i]
                i = i + 1
            }
            return total
        }
        Fail(code) -> { return code }
    }
    return 0
}

Test EmxArrayPayloadEnumFree {
    test {
        var total = 0
        var i = 0
        while i < 300 {
            let ok = emxMakeRange(5)
            let bad = emxMakeRange(0)
            total = total + emxSumRange(ok) + emxSumRange(bad)
            i = i + 1
        }
        return total
    }
    // per iteration: sum(0,2,4,6,8)=20 + (-1) -> 19; 300 * 19 = 5700
    expect { let e: Result<Int, TestFailure> = Result.Ok(5700); return e }
}
