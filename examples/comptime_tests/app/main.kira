import Foundation

comptime function compileAnswer(seed: Int) -> Int {
    return seed + 2
}

@Main
function main() {
    return
}

enum Direction {
    Left
    Up
    Right
    Down
}

function rotate(value: borrow Direction) -> Direction {
    match value {
        Left -> { return .Up }
        Up -> { return .Right }
        Right -> { return .Down }
        Down -> { return .Left }
    }
}

function directionScore(value: borrow Direction) -> Int {
    if value == .Up {
        return 1
    }
    if value == .Right {
        return 2
    }
    if value == .Down {
        return 3
    }
    return 0
}

Test EnumCalculation {
    test {
        let value: Direction = .Left
        return rotate(value)
    }

    expect {
        let expected: Result<Direction, TestFailure> = .Ok(.Up)
        return expected
    }
}

Test IntegerCalculation {
    test {
        return 20 + 22
    }

    expect {
        let expected: Result<Int, TestFailure> = .Ok(42)
        return expected
    }
}

Test ProductCalculation {
    test {
        return 6 * 7
    }

    expect {
        let expected: Result<Int, TestFailure> = .Ok(42)
        return expected
    }
}

Test ComptimeFunctionResult {
    test {
        return compileAnswer(40)
    }

    expect {
        let expected: Result<Int, TestFailure> = .Ok(42)
        return expected
    }
}
