!**/sample.txt
!**/empty.txt
# Lockfiles are tracked (root, foundation/, examples/, benchmarks/) for deterministic
# locked-mode restoration. Only tests-kik locks are ignored: test runs regenerate them
# per-corpus and they were deliberately removed from tracking ("Remove generated corpus
# lockfiles", 71e4d63).
tests-kik/**/kira.lock
.codex/worktrees/
